          activarVistaEnSeccion(secId, destino, btn.dataset.mvVistaBg);
        });
      });
    });

    window.addEventListener("waraira:seccion-cambiada", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (!detail || detail.origen === "movil") return;
      if (detail.seccion && detail.seccion !== root.dataset.seccionActiva) {
        cambiarSeccionMovil(detail.seccion, false);
