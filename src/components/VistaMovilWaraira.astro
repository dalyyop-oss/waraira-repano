    // Modal mapa móvil
    const modal = root.querySelector("#mv-modal-mapa");
    const btnVerMapa = root.querySelector("#mv-btn-ver-mapa");
    const btnCerrarMapa = root.querySelector("#mv-btn-cerrar-mapa");
    const iframeMapa = root.querySelector("#mv-iframe-mapa") as HTMLIFrameElement | null;
    const modalTit = root.querySelector("#mv-modal-titulo");
    const modalSub = root.querySelector("#mv-modal-subtitulo");
    const modalCoords = root.querySelector("#mv-modal-coords");
    const linkGmaps = root.querySelector("#mv-link-gmaps") as HTMLAnchorElement | null;
    let timerIframe: number | null = null;

    const cerrarMapa = () => {
      if (!modal) return;
      modal.classList.remove("abierto");
      if (timerIframe) clearTimeout(timerIframe);
      timerIframe = window.setTimeout(() => {
        if (!modal.classList.contains("abierto") && iframeMapa?.getAttribute("src")) {
          iframeMapa.removeAttribute("src");
        }
      }, 280);
    };

    if (btnVerMapa && modal) {
      btnVerMapa.addEventListener("click", () => {
        if (timerIframe) {
          clearTimeout(timerIframe);
          timerIframe = null;
        }
        const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
        if (modalTit) modalTit.textContent = `Mapa: ${ruta.nombreDetalle}`;
        if (modalSub) modalSub.textContent = ruta.mapaAccesoCorto;
        if (modalCoords) modalCoords.textContent = `Coordenadas: ${ruta.mapaCoords}`;
        if (iframeMapa) {
          iframeMapa.src = `https://maps.google.com/maps?q=${encodeURIComponent(ruta.mapaCoords)}&z=14&output=embed`;
        }
        if (linkGmaps) {
          linkGmaps.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ruta.mapaCoords)}`;
        }
        modal.classList.add("abierto");
      });
    }
    if (btnCerrarMapa) btnCerrarMapa.addEventListener("click", cerrarMapa);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) cerrarMapa();
      });
    }

    // Paginadores genéricos (Emergencias y Normativa)
    root.querySelectorAll<HTMLButtonElement>("[data-mv-grupo][data-mv-pag-idx]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const g = btn.dataset.mvGrupo;
        const idx = btn.dataset.mvPagIdx;
        if (!g || idx === undefined) return;
        root.querySelectorAll<HTMLButtonElement>(`[data-mv-grupo="${g}"][data-mv-pag-idx]`).forEach((b) => {
          b.classList.toggle("activo", b.dataset.mvPagIdx === idx);
        });
        root.querySelectorAll<HTMLElement>(`[data-mv-panel-grupo="${g}"][data-mv-pag-idx]`).forEach((p) => {
          const act = p.dataset.mvPagIdx === idx;
          p.classList.toggle("activa", act);
          if (act) animarSuave(p, 260, 4);
        });
      });
    });

    // Contactos de emergencia
    const tabsContacto = root.querySelectorAll<HTMLButtonElement>("[data-mv-contacto-target]");
    const panesContacto = root.querySelectorAll<HTMLElement>("[data-mv-contacto-pane]");
    tabsContacto.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.mvContactoTarget;
        tabsContacto.forEach((b) => b.classList.toggle("activa", b === btn));
        panesContacto.forEach((p) => {
          const act = p.dataset.mvContactoPane === target;
          p.classList.toggle("activa", act);
          if (act) animarSuave(p, 240, 3);
        });
      });
    });

    // Soporte para URL params (?vista=...&sub=...)
    const params = new URLSearchParams(window.location.search);
    const vParam = params.get("vista");
    if (vParam) {
      const secId = root.dataset.seccionActiva || "quienes-somos";
      const targetBtn = root.querySelector<HTMLButtonElement>(
        `.mv-grupo-maderas[data-mv-maderas-sec="${secId}"] .mv-madera-btn[data-mv-vista-target="${vParam}"]`
      );
      if (targetBtn) {
        activarVistaEnSeccion(secId, vParam, targetBtn.dataset.mvVistaBg);
      }
    }
  }

  document.addEventListener("DOMContentLoaded", inicializarVistaMovil);
  inicializarVistaMovil();
</script>

