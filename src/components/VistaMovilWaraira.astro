---
import {
  SECCIONES_WARAIRA,
  CIFRAS_VALOR_ECOLOGICO,
  CIFRAS_INPARQUES,
  CUMBRES_GEOLOGIA,
  CATALOGO_FLORA_MOVIL,
  CATALOGO_FAUNA_MOVIL,
  RUTAS_PARQUE_MOVIL,
  PREPARA_PAGINAS_MOVIL,
  EXTRAVIO_PASOS_MOVIL,
  URGENCIAS_PAGINAS_MOVIL,
  GOLPES_PAGINAS_MOVIL,
  NIEBLA_PASOS_MOVIL,
  INCENDIO_PAGINAS_MOVIL,
  CONTACTOS_MOVIL,
  NORMATIVA_SECCIONES_MOVIL,
  type SeccionId,
} from "../data/warairaContenido";

export interface Props {
  seccionInicial?: SeccionId;
}

const { seccionInicial = "quienes-somos" } = Astro.props;
const configInicial = SECCIONES_WARAIRA.find((s) => s.id === seccionInicial) || SECCIONES_WARAIRA[0];
---

<div
  class="vista-movil-waraira"
  id="waraira-vista-movil"
  data-seccion-activa={configInicial.id}
  style={`--mv-tema: ${configInicial.color}; --mv-tema-oscuro: ${configInicial.colorOscuro};`}
>
  <!-- Fondo fotográfico fijo en doble capa para fundido cruzado suave -->
  <div class="mv-fondo-fijo" aria-hidden="true">
    <img
      src={configInicial.fondoIntro}
      alt=""
      class="mv-fondo-img mv-fondo-anterior"
      draggable="false"
    />
    <img
      src={configInicial.fondoIntro}
      alt=""
      class="mv-fondo-img mv-fondo-actual"
      draggable="false"
    />
    <div class="mv-fondo-velo"></div>
  </div>

  <!-- Lomita inferior + recorte botánico izquierdo fiel al tema activo -->
  <div class="mv-marco-inferior" aria-hidden="true">
    <img
      src={configInicial.lomitaSvg}
      alt=""
      class="mv-lomita-svg"
      draggable="false"
    />
    <img
      src={configInicial.esquinaImg}
      alt=""
      class="mv-esquina-izq"
      draggable="false"
    />
  </div>

  <!-- Cabezal fijo móvil: madera superior + 5 módulos + listón de maderas secundarias -->
  <header class="mv-header" role="banner" aria-label="Navegación móvil Parque Nacional Waraira Repano">
    <div class="mv-barra-marca">
      <button
        type="button"
        class="mv-btn-letrero-principal"
        aria-label="WARAIRA REPANO - Volver a la portada de esta sección"
        title="Volver a la portada de la sección"
      >
        <img
          src="/elementos/poste-madera-limpio.webp"
          alt="Waraira Repano"
          class="mv-img-letrero-recortada"
          draggable="false"
        />
      </button>
      <div class="mv-indicador-modulo-actual">
        <span class="mv-punto-color"></span>
        <span class="mv-titulo-modulo-bar">{configInicial.titulo}</span>
      </div>
    </div>

    <!-- 5 botones de secciones con la síntesis poligonal detrás (estilo Techo.astro) -->
    <nav class="mv-techo-tabs" aria-label="Secciones principales">
      <img
        src="/elementos/silueta-waraira-cabezal.webp"
        alt=""
        aria-hidden="true"
        class="mv-silueta-cabezal"
        draggable="false"
      />
      {SECCIONES_WARAIRA.map((sec) => (
        <button
          type="button"
          class:list={["mv-techo-tab", { activa: sec.id === configInicial.id }]}
          data-mv-sec={sec.id}
          data-mv-color={sec.color}
          data-mv-oscuro={sec.colorOscuro}
          data-mv-titulo={sec.titulo}
          data-mv-lomita={sec.lomitaSvg}
          data-mv-esquina={sec.esquinaImg}
          data-mv-fondo={sec.fondoIntro}
          style={`--tab-color: ${sec.color};`}
          aria-pressed={sec.id === configInicial.id ? "true" : "false"}
        >
          <span class="mv-tab-fondo"></span>
          <span class="mv-tab-indicador"></span>
          <span class="mv-tab-texto">
            {sec.etiquetaLineas[0]}
            <br />
            {sec.etiquetaLineas[1]}
          </span>
        </button>
      ))}
    </nav>

    <!-- Listones de madera horizontales deslizables para las subsecciones -->
    <nav class="mv-subnav-maderas" aria-label="Subsecciones del módulo activo">
      {SECCIONES_WARAIRA.map((sec) => (
        <div
          class:list={["mv-grupo-maderas", { activo: sec.id === configInicial.id }]}
          data-mv-maderas-sec={sec.id}
        >
          {sec.subvistas.map((sub, idx) => (
            <button
              type="button"
              class:list={["mv-madera-btn", { activa: idx === 0 }]}
              data-mv-vista-target={sub.id}
              data-mv-vista-bg={sub.fondo || sec.fondoIntro}
            >
              {sub.etiqueta}
            </button>
          ))}
        </div>
      ))}
    </nav>
  </header>

  <!-- Cuerpo principal desplazable verticalmente -->
  <main class="mv-contenido" id="mv-contenido-principal">
    <!-- ==========================================================
         SECCIÓN 1: ¿QUIÉNES SOMOS?
         ========================================================== -->
    <section
      class:list={["mv-seccion", { activa: configInicial.id === "quienes-somos" }]}
      data-mv-seccion="quienes-somos"
      data-mv-vista-actual="intro"
    >
      <!-- Vista Intro -->
      <article class="mv-vista activa" data-mv-vista="intro">
        <div class="mv-card-intro">
          <div class="mv-card-intro-tab">P.N. Waraira Repano</div>
          <div class="mv-card-intro-cuerpo">
            <h1 class="mv-intro-subtitulo">El Corazón Verde de Caracas</h1>
            <p class="mv-texto-blanco">
              Somos el pulmón vegetal que resguarda la biodiversidad, la historia y la esencia de nuestra región. Más que una majestuosa montaña, el Parque Nacional Waraira Repano es:
            </p>
            <div class="mv-insignias-grid">
              <div class="mv-insignia-pill">
                <img src="/iconos/icono-guardian-refugio.webp" alt="" loading="lazy" />
                <span>Guardián y refugio natural</span>
              </div>
              <div class="mv-insignia-pill">
                <img src="/iconos/icono-espacio-paz.webp" alt="" loading="lazy" />
                <span>Espacio vivo de paz</span>
              </div>
            </div>
            <p class="mv-texto-blanco">
              Protege la flora y fauna silvestre y conecta a la comunidad con la magia de la naturaleza en el centro mismo de la ciudad.
            </p>
          </div>
        </div>

        <figure class="mv-card-foto-sola">
          <div class="mv-foto-marco">
            <img
              src="/fotos/quienes-somos/hotel-humboldt-lagunazo.webp"
              alt="Hotel Humboldt visto desde el Lagunazo"
              loading="lazy"
            />
          </div>
          <figcaption class="mv-pie-foto">
            Hotel Humboldt visto desde el Lagunazo.
          </figcaption>
        </figure>
      </article>

      <!-- Vista Misión y Visión -->
      <article class="mv-vista" data-mv-vista="mision-vision">
        <div class="mv-card-doble-tab">
          <div class="mv-doble-tab-barra" role="tablist" aria-label="Misión y Visión">
            <button type="button" class="mv-doble-tab-btn activa" data-mv-qs-tab="mision" role="tab" aria-selected="true">
              Misión
            </button>
            <button type="button" class="mv-doble-tab-btn" data-mv-qs-tab="vision" role="tab" aria-selected="false">
              Visión
            </button>
          </div>
          <div class="mv-card-cuerpo">
            <div class="mv-subpanel activa" data-mv-qs-panel="mision">
              <p>
                <strong>Conservar y proteger</strong> la biodiversidad del Parque Nacional Waraira Repano, promoviendo el uso sustentable de sus recursos naturales y la educación ambiental para las generaciones presentes y futuras.
              </p>
            </div>
            <div class="mv-subpanel" data-mv-qs-panel="vision">
              <p>
                Ser un referente mundial en la gestión de parques nacionales, donde la <strong>conservación ecológica</strong> convive armónicamente con el desarrollo turístico responsable y la investigación científica.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- Vista Valor ecológico -->
      <article class="mv-vista" data-mv-vista="valor-ecologico">
        <div class="mv-card-contenido">
          <div class="mv-card-header-tab">
            <h2 class="mv-card-titulo-tab">Valor ecológico</h2>
          </div>
          <div class="mv-card-cuerpo">
            <p>
              Como epicentro de vida silvestre, este parque resguarda un patrimonio natural invaluable, <strong>su valor se manifiesta en:</strong>
            </p>
            <ul class="mv-lista-puntos-color">
              <li>Alta biodiversidad</li>
              <li>Regulación climática</li>
              <li>Protección de fuentes de agua</li>
              <li>Refugio de flora y fauna silvestre</li>
            </ul>
            <p class="mv-subtitulo-acento">Este espacio natural es el refugio de:</p>
          </div>
        </div>

        <div class="mv-grid-bio">
          {CIFRAS_VALOR_ECOLOGICO.map((item) => (
            <div class="mv-bio-card">
              <div class="mv-bio-top">
                <span class="mv-bio-cifra">{item.cifra}</span>
                <img src={item.icono} alt="" loading="lazy" />
              </div>
              <span class="mv-bio-etiqueta">{item.etiqueta}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- Vista INPARQUES -->
      <article class="mv-vista" data-mv-vista="inparques">
        <div class="mv-card-contenido">
          <div class="mv-card-header-tab">
            <h2 class="mv-card-titulo-tab">INPARQUES</h2>
          </div>
          <div class="mv-card-cuerpo">
            <p>
              <strong>El Instituto Nacional de Parques</strong> es una institución adscrita al Ministerio del Poder Popular para el Ecosocialismo y Aguas (Minea), creada por ley del 03 de octubre de 1973.
            </p>
            <p class="mv-mt-12">
              Tiene como misión ser el ente rector de las políticas públicas orientadas a la protección y manejo del sistema de parques de Venezuela, se encuentra <strong class="mv-texto-acento">integrado por:</strong>
            </p>
          </div>
        </div>

        <div class="mv-grid-inparques">
          {CIFRAS_INPARQUES.map((c) => (
            <div class="mv-inparques-card">
              <span class="mv-inparques-cifra">{c.cifra}</span>
              <span class="mv-inparques-etiqueta">{c.etiqueta}</span>
            </div>
          ))}
        </div>

        <div class="mv-logo-card">
          <img src="/elementos/svg/logo-inparques.svg" alt="Logotipo de INPARQUES" loading="lazy" />
        </div>
      </article>
    </section>

    <!-- ==========================================================
         SECCIÓN 2: PATRIMONIO NATURAL
         ========================================================== -->
    <section
      class:list={["mv-seccion", { activa: configInicial.id === "patrimonio-natural" }]}
      data-mv-seccion="patrimonio-natural"
      data-mv-vista-actual="intro"
    >
      <!-- Intro -->
      <article class="mv-vista activa" data-mv-vista="intro">
        <div class="mv-card-intro">
          <div class="mv-card-intro-tab">Patrimonio Natural</div>
          <div class="mv-card-intro-cuerpo">
            <p class="mv-texto-blanco">
              Decretado como Parque Nacional el 12 de diciembre de 1958 (Decreto N° 473). El parque abarca una superficie de más de 85.000 hectáreas que se extienden a lo largo de la serranía.
            </p>
            <p class="mv-texto-blanco mv-mt-12">
              En 2010, mediante la Ley de Protección del Parque Nacional, se ratificó de forma oficial la denominación indígena Waraira Repano, término derivado de la lengua de las etnias originarias Caribes que significa «Sierra Grande» o «Lugar de dantas».
            </p>
          </div>
        </div>
      </article>

      <!-- Clima -->
      <article class="mv-vista" data-mv-vista="clima">
        <div class="mv-card-contenido">
          <div class="mv-card-header-tab">
            <h2 class="mv-card-titulo-tab">Clima</h2>
          </div>
          <div class="mv-card-cuerpo">
            <p>
              El clima del Parque es de montaña, con diferencias notables de acuerdo con la altitud y los pisos térmicos correspondientes y también de acuerdo a la exposición de sus laderas con respecto a la insolación y a la procedencia de los vientos.
            </p>
            <div class="mv-insignia-clima">
              <img src="/iconos/icono-clima-frio.webp" alt="Icono clima frío de montaña" loading="lazy" />
              <span>Clima frío de montaña</span>
            </div>
          </div>
        </div>

        <figure class="mv-card-foto-sola">
          <div class="mv-foto-marco">
            <img src="/fotos/patrimonio/pico-naiguata-clima.webp" alt="Pico Naiguatá" loading="lazy" />
          </div>
          <figcaption class="mv-pie-foto">Pico Naiguatá</figcaption>
        </figure>
      </article>

      <!-- Geología -->
      <article class="mv-vista" data-mv-vista="geologia">
        <div class="mv-card-contenido">
          <div class="mv-card-header-tab">
            <h2 class="mv-card-titulo-tab">Geología</h2>
            <div class="mv-paginador-muesca" role="tablist" aria-label="Páginas de Geología">
              {[1, 2].map((p) => (
                <button
                  type="button"
                  class:list={["mv-dot-cuadro", { activo: p === 1 }]}
                  data-mv-geo-pag={String(p)}
                  aria-label={`Geología página ${p}`}
                  aria-selected={p === 1 ? "true" : "false"}
                />
              ))}
            </div>
          </div>
          <div class="mv-card-cuerpo">
            <div class="mv-subpanel activa" data-mv-geo-panel="1">
              <p>
                Corresponde a una abrupta región montañosa con laderas muy pendientes, originada a partir del hundimiento de la placa del Caribe y el levantamiento de la placa continental sudamericana durante el período Eoceno.
              </p>
              <p class="mv-mt-12">
                También está constituido por rocas deformadas y meteorizadas del período Cretácico.
              </p>
            </div>

            <div class="mv-subpanel" data-mv-geo-panel="2">
              <p>Al recorrer la cordillera, destacan de forma natural sus puntos más elevados:</p>
              <div class="mv-chips-lista mv-mt-12">
                {CUMBRES_GEOLOGIA.map((c, idx) => (
                  <button
                    type="button"
                    class:list={["mv-chip-btn", { activo: idx === 0 }]}
                    data-mv-cumbre-foto={c.foto}
                    data-mv-cumbre-nombre={c.nombre}
                    data-mv-cumbre-desc={c.desc}
                    data-mv-cumbre-altura={c.altura}
                  >
                    {c.nombre}
                  </button>
                ))}
              </div>
              <div class="mv-visor-cumbre mv-mt-12">
                <div class="mv-foto-marco">
                  <img
                    id="mv-img-cumbre"
                    src={CUMBRES_GEOLOGIA[0].foto}
                    alt={CUMBRES_GEOLOGIA[0].nombre}
                    loading="lazy"
                  />
                </div>
                <p id="mv-desc-cumbre" class="mv-visor-desc">{CUMBRES_GEOLOGIA[0].desc}</p>
                <p id="mv-altura-cumbre" class="mv-visor-altura">{CUMBRES_GEOLOGIA[0].altura}</p>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Hidrografía -->
      <article class="mv-vista" data-mv-vista="hidrografia">
        <div class="mv-card-contenido">
          <div class="mv-card-header-tab">
            <h2 class="mv-card-titulo-tab">Hidrografía</h2>
          </div>
          <div class="mv-card-cuerpo">
            <p>
              El abundante volumen de agua del parque drena al <strong>mar Caribe</strong> mediante una densa red hidrográfica <strong class="mv-texto-acento">dividida en dos vertientes:</strong>
            </p>
          </div>
        </div>

        <div class="mv-vertientes-stack">
          <div class="mv-card-secundaria">
            <h3>Vertiente Norte</h3>
            <ul>
              <li>Desemboca directamente en el Litoral Central.</li>
              <li>Alimenta la cuenca del río Guaire, principal colector de la capital.</li>
            </ul>
          </div>
          <div class="mv-card-secundaria">
            <h3>Vertiente Sur</h3>
            <ul>
              <li>Desemboca de forma indirecta, principalmente a través del río Tuy.</li>
            </ul>
          </div>
        </div>
      </article>

      <!-- Flora y Fauna -->
      <article class="mv-vista" data-mv-vista="flora-fauna">
        <div class="mv-card-doble-tab">
          <div class="mv-doble-tab-barra" role="tablist" aria-label="Flora y Fauna">
            <div class="mv-doble-tab-btn con-muesca activa" data-mv-ff-tab="flora" role="tab" aria-selected="true" tabindex="0">
              <span>Flora</span>
              <span class="mv-muesca-inline">
                <button type="button" class="mv-dot-cuadro activo" data-mv-flora-pag="1" aria-label="Flora página 1"></button>
                <button type="button" class="mv-dot-cuadro" data-mv-flora-pag="2" aria-label="Flora página 2"></button>
              </span>
            </div>
            <div class="mv-doble-tab-btn con-muesca" data-mv-ff-tab="fauna" role="tab" aria-selected="false" tabindex="0">
              <span>Fauna</span>
              <span class="mv-muesca-inline">
                <button type="button" class="mv-dot-cuadro activo" data-mv-fauna-pag="1" aria-label="Fauna página 1"></button>
                <button type="button" class="mv-dot-cuadro" data-mv-fauna-pag="2" aria-label="Fauna página 2"></button>
              </span>
            </div>
          </div>

          <div class="mv-card-cuerpo">
            <!-- Bloque Flora -->
            <div class="mv-subpanel activa" data-mv-ff-bloque="flora">
              <div class="mv-subpanel activa" data-mv-flora-panel="1">
                <p>
                  El parque alberga una extraordinaria diversidad vegetal que varía con la altitud. Desde los bosques secos de la base hasta los subpáramos de las cumbres, cada piso altitudinal presenta comunidades vegetales únicas y adaptadas a sus condiciones específicas.
                </p>
                <button type="button" class="mv-btn-accion-secundaria mv-mt-12" data-mv-ir-catalogo="flora">
                  Explorar especies de Flora
                </button>
              </div>

              <div class="mv-subpanel" data-mv-flora-panel="2">
                <p>Dentro de esta vasta riqueza botánica destacan:</p>
                <div class="mv-chips-lista mv-chips-grid mv-mt-12">
                  {CATALOGO_FLORA_MOVIL.map((cat, idx) => (
                    <button
                      type="button"
                      class:list={["mv-chip-btn", { activo: idx === 0 }]}
                      data-mv-flora-cat={cat.id}
                    >
                      {cat.nombre}
                    </button>
                  ))}
                </div>
                <div class="mv-visor-especie mv-mt-12">
                  <div class="mv-especie-fila-foto">
                    <div class="mv-foto-marco-especie">
                      <img
                        id="mv-img-flora"
                        src={CATALOGO_FLORA_MOVIL[0].especies[0].foto}
                        alt={CATALOGO_FLORA_MOVIL[0].especies[0].comun}
                        loading="lazy"
                      />
                    </div>
                    <div class="mv-dots-verticales" role="tablist" aria-label="Especies de Flora">
                      {[0, 1, 2].map((i) => (
                        <button
                          type="button"
                          class:list={["mv-dot-especie", { activo: i === 0 }]}
                          data-mv-flora-idx={String(i)}
                          aria-label={`Especie de flora ${i + 1}`}
                        />
                      ))}
                    </div>
                  </div>
                  <p class="mv-especie-pie">
                    <strong id="mv-flora-comun">{CATALOGO_FLORA_MOVIL[0].especies[0].comun}</strong> -{" "}
                    <em id="mv-flora-cient">{CATALOGO_FLORA_MOVIL[0].especies[0].cientifico}</em>
                  </p>
                </div>
              </div>
            </div>

            <!-- Bloque Fauna -->
            <div class="mv-subpanel" data-mv-ff-bloque="fauna">
              <div class="mv-subpanel activa" data-mv-fauna-panel="1">
                <p>
                  El Warairarepano constituye un refugio biológico estratégico en la región central de Venezuela.
                </p>
                <p class="mv-mt-12">
                  A nivel de especies, su geografía alberga desde mamíferos de gran porte y una amplia variedad de aves nativas y migratorias, hasta anfibios y reptiles adaptados a los microclimas específicos de la montaña.
                </p>
                <button type="button" class="mv-btn-accion-secundaria mv-mt-12" data-mv-ir-catalogo="fauna">
                  Explorar especies de Fauna
                </button>
              </div>

              <div class="mv-subpanel" data-mv-fauna-panel="2">
                <p>La montaña alberga distintas comunidades de fauna, cada una moldeada por su nivel de altitud:</p>
                <div class="mv-chips-lista mv-chips-grid mv-mt-12">
                  {CATALOGO_FAUNA_MOVIL.map((cat, idx) => (
                    <button
                      type="button"
                      class:list={["mv-chip-btn", { activo: idx === 0 }]}
                      data-mv-fauna-cat={cat.id}
                    >
                      {cat.nombre}
                    </button>
                  ))}
                </div>
                <div class="mv-visor-especie mv-mt-12">
                  <div class="mv-especie-fila-foto">
                    <div class="mv-foto-marco-especie">
                      <img
                        id="mv-img-fauna"
                        src={CATALOGO_FAUNA_MOVIL[0].especies[0].foto}
                        alt={CATALOGO_FAUNA_MOVIL[0].especies[0].comun}
                        loading="lazy"
                      />
                    </div>
                    <div class="mv-dots-verticales" role="tablist" aria-label="Especies de Fauna">
                      {[0, 1, 2].map((i) => (
                        <button
                          type="button"
                          class:list={["mv-dot-especie", { activo: i === 0 }]}
                          data-mv-fauna-idx={String(i)}
                          aria-label={`Especie de fauna ${i + 1}`}
                        />
                      ))}
                    </div>
                  </div>
                  <p class="mv-especie-pie">
                    <strong id="mv-fauna-comun">{CATALOGO_FAUNA_MOVIL[0].especies[0].comun}</strong> -{" "}
                    <em id="mv-fauna-cient">{CATALOGO_FAUNA_MOVIL[0].especies[0].cientifico}</em>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- ==========================================================
         SECCIÓN 3: GUÍA DEL VISITANTE
         ========================================================== -->
    <section
      class:list={["mv-seccion", { activa: configInicial.id === "guia-visitante" }]}
      data-mv-seccion="guia-visitante"
      data-mv-vista-actual="intro"
    >
      <!-- Intro -->
