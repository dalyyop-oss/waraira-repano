          </div>
          <div class="mv-card-cuerpo">
            <div class="mv-lead-con-icono">
              <div
                class="mv-icono-svg-wrap"
                style={`--ix: ${ICONOS_EMERGENCIAS_SVG["contactos-emergencia"].x}px; --iy: ${ICONOS_EMERGENCIAS_SVG["contactos-emergencia"].y}px;`}
                aria-hidden="true"
              >
                <img src={ICONOS_EMERGENCIAS_SVG["contactos-emergencia"].svg} alt="" loading="lazy" />
              </div>
              <p class="mv-prose">
                {te("Ante cualquier accidente, extravío o eventualidad en la montaña, comunícate de inmediato con los organismos de rescate y protección.")}
              </p>
            </div>
            <div class="mv-contactos-tabs mv-mt-12">
              {CONTACTOS_MOVIL.map((c, idx) => (
                <button
                  type="button"
                  class:list={["mv-tab-contacto", { activa: idx === 0 }]}
                  data-mv-contacto-target={c.id}
                >
                  {c.etiquetaLineas[0]}
                  <br />
                  {c.etiquetaLineas[1]}
                </button>
              ))}
            </div>
            <div class="mv-contactos-panel-box mv-mt-12">
              {CONTACTOS_MOVIL.map((c, idx) => (
                <div class:list={["mv-subpanel", { activa: idx === 0 }]} data-mv-contacto-pane={c.id}>
                  {c.tipo === "grid" ? (
                    <div class="mv-numeros-grid">
                      {c.numeros.map((n) => (
                        <a href={n.href} class="mv-num-enlace">
                          <span class="mv-operadora">{n.operadora}</span>
                          <strong class="mv-num-valor">{n.numero}</strong>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <a href={c.href} class="mv-num-enlace mv-num-fijo">
                      <span class="mv-operadora">{c.codigo}</span>
                      <strong class="mv-num-valor">{c.numero}</strong>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- ==========================================================
         SECCIÓN 5: CONOCE SU NORMATIVA
         ========================================================== -->
    <section
      class:list={["mv-seccion", { activa: configInicial.id === "normativa" }]}
      data-mv-seccion="normativa"
      data-mv-vista-actual="intro"
    >
      <!-- Intro -->
      <article class="mv-vista activa" data-mv-vista="intro">
        <div class="mv-card-intro">
          <div class="mv-card-intro-tab">Normativa del parque</div>
          <div class="mv-card-intro-cuerpo">
            <p class="mv-texto-blanco mv-prose">
              {te("De acuerdo con el Plan de Ordenamiento y Reglamento de Uso (PORU), el Instituto Nacional de Parques (INPARQUES) establece un conjunto de normas de cumplimiento obligatorio para garantizar la preservación de los ecosistemas del Parque Nacional Waraira Repano y la seguridad de sus visitantes.")}
            </p>
            <p class="mv-texto-blanco mv-mt-12 mv-prose">
              {te("Conocer y respetar estas directrices es fundamental para disfrutar de la montaña de forma responsable.")}
            </p>
          </div>
        </div>
      </article>

      {Object.entries(NORMATIVA_SECCIONES_MOVIL).map(([key, sec]) => (
        <article class="mv-vista" data-mv-vista={key}>
          <div class="mv-card-contenido">
            <div class="mv-card-header-tab">
              <h2 class="mv-card-titulo-tab">{sec.titulo}</h2>
              <div class="mv-paginador-muesca" data-mv-pag-grupo={`norm-${key}`} role="tablist">
                {sec.paginas.map((_, idx) => (
                  <button
                    type="button"
                    class:list={["mv-dot-svg-btn", { activo: idx === 0 }]}
                    data-mv-grupo={`norm-${key}`}
                    data-mv-pag-idx={String(idx)}
                    aria-label={`${sec.titulo} página ${idx + 1}`}
                  >
                    <img class="mv-dot-activo" src="/elementos/svg/dot-normativa-activo.svg" alt="" draggable="false" />
                    <img class="mv-dot-inactivo" src="/elementos/svg/dot-normativa-inactivo.svg" alt="" draggable="false" />
                  </button>
                ))}
              </div>
            </div>
            <div class="mv-card-cuerpo">
              <div class="mv-lead-con-icono">
                <div
                  class="mv-icono-svg-wrap"
                  style={`--ix: ${sec.iconX}px; --iy: ${sec.iconY}px;`}
                  aria-hidden="true"
                >
                  <img src={sec.svgSuperior} alt="" loading="lazy" />
                </div>
                <p class="mv-prose">{te(sec.lead)}</p>
              </div>
              {sec.paginas.map((bullets, idx) => (
                <div
                  class:list={["mv-subpanel mv-mt-12", { activa: idx === 0 }]}
                  data-mv-panel-grupo={`norm-${key}`}
                  data-mv-pag-idx={String(idx)}
                >
                  <ul class="mv-lista-puntos-normativa">
                    {bullets.map((b) => (
                      <li class="mv-prose">{te(b)}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>

  <!-- Modal mapa móvil -->
  <div class="mv-modal-mapa-overlay" id="mv-modal-mapa" role="dialog" aria-modal="true" aria-labelledby="mv-modal-titulo">
    <div class="mv-modal-mapa-card">
      <header class="mv-modal-header">
        <div>
          <h2 id="mv-modal-titulo">Mapa de ruta</h2>
          <p id="mv-modal-subtitulo"></p>
        </div>
        <button type="button" class="mv-modal-cerrar" id="mv-btn-cerrar-mapa" aria-label="Cerrar mapa">×</button>
      </header>
      <div class="mv-modal-cuerpo">
        <iframe
          id="mv-iframe-mapa"
          title="Ubicación de la ruta en el Parque Nacional Waraira Repano"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <footer class="mv-modal-footer">
        <span id="mv-modal-coords"></span>
        <a id="mv-link-gmaps" href="https://maps.google.com" target="_blank" rel="noopener noreferrer">
          Google Maps
        </a>
      </footer>
    </div>
  </div>
</div>

<script>
  import {
    CATALOGO_FLORA_MOVIL,
    CATALOGO_FAUNA_MOVIL,
    RUTAS_PARQUE_MOVIL,
    tipografiaEditorial,
  } from "../data/warairaContenido";

  function inicializarVistaMovil() {
    const root = document.getElementById("waraira-vista-movil") as HTMLElement | null;
    if (!root || root.dataset.inicializado === "1") return;
    root.dataset.inicializado = "1";

    const imgFondoActual = root.querySelector(".mv-fondo-actual") as HTMLImageElement | null;
    const imgFondoAnterior = root.querySelector(".mv-fondo-anterior") as HTMLImageElement | null;
    const imgLomita = root.querySelector(".mv-lomita-svg") as HTMLImageElement | null;
    const imgEsquina = root.querySelector(".mv-esquina-izq") as HTMLImageElement | null;

    const tabsTecho = root.querySelectorAll<HTMLButtonElement>(".mv-techo-tab[data-mv-sec]");
    const gruposMaderas = root.querySelectorAll<HTMLElement>(".mv-grupo-maderas[data-mv-maderas-sec]");
    const secciones = root.querySelectorAll<HTMLElement>(".mv-seccion[data-mv-seccion]");
    const btnMarcaPrincipal = root.querySelector<HTMLButtonElement>(".mv-btn-letrero-principal");

    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const animarSuave = (el: Element | null, dur = 320, fromY = 6) => {
      if (!el || reduceMotion()) return;
      el.getAnimations().forEach((a) => a.cancel());
      el.animate(
        [
          { opacity: 0.12, transform: fromY ? `translateY(${fromY}px)` : "none" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: dur, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
      );
    };

    const cacheImagenes = new Map<string, HTMLImageElement>();
    const precargarImg = (src: string) => {
      let cached = cacheImagenes.get(src);
      if (!cached) {
        cached = new Image();
        cached.src = src;
        cacheImagenes.set(src, cached);
      }
      return cached;
    };

    let tokenFondo = 0;
    const cambiarFondoMovil = (nuevoBg?: string) => {
      if (!imgFondoActual || !nuevoBg || imgFondoActual.getAttribute("src") === nuevoBg) return;
      const miToken = ++tokenFondo;
      if (imgFondoAnterior) {
        imgFondoAnterior.src = imgFondoActual.getAttribute("src") || nuevoBg;
      }
      const cached = precargarImg(nuevoBg);
      const aplicar = () => {
        if (miToken !== tokenFondo) return;
        imgFondoActual.getAnimations().forEach((a) => a.cancel());
        imgFondoActual.src = nuevoBg;
        if (!reduceMotion()) {
          imgFondoActual.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          );
        }
      };
      if (cached.complete && cached.naturalWidth > 0) aplicar();
      else {
        cached.addEventListener("load", aplicar, { once: true });
        cached.addEventListener("error", aplicar, { once: true });
      }
    };

    // Precarga limpia de fotos de especies y rutas
    CATALOGO_FLORA_MOVIL.forEach((c) => c.especies.forEach((e) => precargarImg(e.foto)));
    CATALOGO_FAUNA_MOVIL.forEach((c) => c.especies.forEach((e) => precargarImg(e.foto)));
    RUTAS_PARQUE_MOVIL.forEach((r) => {
      precargarImg(r.fotoLista);
      r.fotosDetalle.forEach((f) => precargarImg(f));
    });

    function activarVistaEnSeccion(secId: string, vistaId: string, fondoCustom?: string) {
      const secEl = root.querySelector<HTMLElement>(`.mv-seccion[data-mv-seccion="${secId}"]`);
      if (!secEl) return;

      secEl.dataset.mvVistaActual = vistaId;
      secEl.querySelectorAll<HTMLElement>(".mv-vista[data-mv-vista]").forEach((v) => {
        const esAct = v.dataset.mvVista === vistaId;
        v.classList.toggle("activa", esAct);
        if (esAct) animarSuave(v, 320, 6);
      });

      if (btnMarcaPrincipal) {
        btnMarcaPrincipal.classList.toggle("activo", vistaId === "intro");
      }

      const madTarget = vistaId === "detalle-ruta" ? "rutas-parque" : vistaId;
      const grupo = root.querySelector(`.mv-grupo-maderas[data-mv-maderas-sec="${secId}"]`);
      if (grupo) {
        grupo.querySelectorAll<HTMLButtonElement>(".mv-madera-btn").forEach((b) => {
          const activa = b.dataset.mvVistaTarget === madTarget;
          b.classList.toggle("activa", activa);
          if (activa) {
            b.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          }
        });
      }

      if (fondoCustom) {
        cambiarFondoMovil(fondoCustom);
      }
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    }

    function cambiarSeccionMovil(secId: string, propagar = true) {
      const tab = Array.from(tabsTecho).find((t) => t.dataset.mvSec === secId);
      if (!tab) return;

      root.dataset.seccionActiva = secId;
      const color = tab.dataset.mvColor || "#ff8f00";
      const oscuro = tab.dataset.mvOscuro || "#cc6f00";
      root.style.setProperty("--mv-tema", color);
      root.style.setProperty("--mv-tema-oscuro", oscuro);

      if (imgLomita && tab.dataset.mvLomita && imgLomita.getAttribute("src") !== tab.dataset.mvLomita) {
        imgLomita.src = tab.dataset.mvLomita;
      }
      if (imgEsquina && tab.dataset.mvEsquina && imgEsquina.getAttribute("src") !== tab.dataset.mvEsquina) {
        imgEsquina.src = tab.dataset.mvEsquina;
      }

      tabsTecho.forEach((t) => {
        const act = t.dataset.mvSec === secId;
        t.classList.toggle("activa", act);
        t.setAttribute("aria-pressed", act ? "true" : "false");
      });

      gruposMaderas.forEach((g) => {
        g.classList.toggle("activo", g.dataset.mvMaderasSec === secId);
      });

      secciones.forEach((s) => {
        const esAct = s.dataset.mvSeccion === secId;
        s.classList.toggle("activa", esAct);
        if (esAct) animarSuave(s, 340, 6);
      });

      const secEl = root.querySelector<HTMLElement>(`.mv-seccion[data-mv-seccion="${secId}"]`);
      const vistaActual = secEl?.dataset.mvVistaActual || "intro";
      if (btnMarcaPrincipal) {
        btnMarcaPrincipal.classList.toggle("activo", vistaActual === "intro");
      }
      const btnMadera = root.querySelector<HTMLButtonElement>(
        `.mv-grupo-maderas[data-mv-maderas-sec="${secId}"] .mv-madera-btn[data-mv-vista-target="${vistaActual}"]`
      );
      cambiarFondoMovil(btnMadera?.dataset.mvVistaBg || tab.dataset.mvFondo);

      if (propagar) {
        window.dispatchEvent(
          new CustomEvent("waraira:seccion-cambiada", {
            detail: { seccion: secId, origen: "movil" },
          })
        );
      }
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    }

    tabsTecho.forEach((tab) => {
      tab.addEventListener("click", () => {
        const destino = tab.dataset.mvSec;
        if (destino) cambiarSeccionMovil(destino, true);
      });
    });

    if (btnMarcaPrincipal) {
      btnMarcaPrincipal.addEventListener("click", () => {
        const secId = root.dataset.seccionActiva || "quienes-somos";
        const tab = root.querySelector<HTMLButtonElement>(`.mv-techo-tab[data-mv-sec="${secId}"]`);
        activarVistaEnSeccion(secId, "intro", tab?.dataset.mvFondo);
      });
    }

    gruposMaderas.forEach((grupo) => {
      const secId = grupo.dataset.mvMaderasSec || "quienes-somos";
      grupo.querySelectorAll<HTMLButtonElement>(".mv-madera-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const destino = btn.dataset.mvVistaTarget || "intro";
          activarVistaEnSeccion(secId, destino, btn.dataset.mvVistaBg);
        });
      });
    });

    window.addEventListener("waraira:seccion-cambiada", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (!detail || detail.origen === "movil") return;
      if (detail.seccion && detail.seccion !== root.dataset.seccionActiva) {
        cambiarSeccionMovil(detail.seccion, false);
      }
    });

    // Misión / Visión
    const btnsQsTab = root.querySelectorAll<HTMLButtonElement>("[data-mv-qs-tab]");
    const panelsQs = root.querySelectorAll<HTMLElement>("[data-mv-qs-panel]");
    btnsQsTab.forEach((btn) => {
      btn.addEventListener("click", () => {
        const t = btn.dataset.mvQsTab;
        btnsQsTab.forEach((b) => {
          const act = b === btn;
          b.classList.toggle("activa", act);
          b.setAttribute("aria-selected", act ? "true" : "false");
        });
        panelsQs.forEach((p) => {
          const act = p.dataset.mvQsPanel === t;
          p.classList.toggle("activa", act);
          if (act) animarSuave(p, 260, 4);
        });
      });
    });

    // Geología paginator + 5 cumbres
    const btnsGeoPag = root.querySelectorAll<HTMLButtonElement>("[data-mv-geo-pag]");
    const panelsGeo = root.querySelectorAll<HTMLElement>("[data-mv-geo-panel]");
    btnsGeoPag.forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = btn.dataset.mvGeoPag;
        btnsGeoPag.forEach((b) => {
          const act = b === btn;
          b.classList.toggle("activo", act);
          b.setAttribute("aria-selected", act ? "true" : "false");
        });
        panelsGeo.forEach((panel) => {
          const act = panel.dataset.mvGeoPanel === p;
          panel.classList.toggle("activa", act);
          if (act) animarSuave(panel, 280, 4);
        });
      });
    });

    const btnsCumbre = root.querySelectorAll<HTMLButtonElement>("[data-mv-cumbre-foto]");
    const imgCumbre = root.querySelector("#mv-img-cumbre") as HTMLImageElement | null;
    const descCumbre = root.querySelector("#mv-desc-cumbre");
    const altCumbre = root.querySelector("#mv-altura-cumbre");
    btnsCumbre.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.classList.contains("activo")) return;
        btnsCumbre.forEach((b) => b.classList.remove("activo"));
        btn.classList.add("activo");
        if (imgCumbre && btn.dataset.mvCumbreFoto) {
          imgCumbre.src = btn.dataset.mvCumbreFoto;
          imgCumbre.alt = btn.dataset.mvCumbreNombre || "";
          animarSuave(imgCumbre, 260, 0);
        }
        if (descCumbre) descCumbre.textContent = tipografiaEditorial(btn.dataset.mvCumbreDesc || "");
        if (altCumbre) altCumbre.textContent = btn.dataset.mvCumbreAltura || "";
      });
    });

    // Flora y Fauna
    let catFlora = CATALOGO_FLORA_MOVIL[0].id;
    let idxFlora = 0;
    let catFauna = CATALOGO_FAUNA_MOVIL[0].id;
    let idxFauna = 0;

    const btnsFFTab = root.querySelectorAll<HTMLElement>("[data-mv-ff-tab]");
    const bloquesFF = root.querySelectorAll<HTMLElement>("[data-mv-ff-bloque]");
    const cambiarFFTab = (tabId: string) => {
      btnsFFTab.forEach((b) => {
        const act = b.dataset.mvFfTab === tabId;
        b.classList.toggle("activa", act);
        b.setAttribute("aria-selected", act ? "true" : "false");
      });
      bloquesFF.forEach((bl) => {
        const act = bl.dataset.mvFfBloque === tabId;
        bl.classList.toggle("activa", act);
        if (act) animarSuave(bl, 280, 4);
      });
    };
    btnsFFTab.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.mvFfTab) cambiarFFTab(btn.dataset.mvFfTab);
      });
      btn.addEventListener("keydown", (e) => {
        if ((e.key === "Enter" || e.key === " ") && btn.dataset.mvFfTab) {
          e.preventDefault();
          cambiarFFTab(btn.dataset.mvFfTab);
        }
      });
    });

    const activarFloraPag = (pag: string) => {
      cambiarFFTab("flora");
      root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-pag]").forEach((b) => {
        b.classList.toggle("activo", b.dataset.mvFloraPag === pag);
      });
      root.querySelectorAll<HTMLElement>("[data-mv-flora-panel]").forEach((p) => {
        const act = p.dataset.mvFloraPanel === pag;
        p.classList.toggle("activa", act);
        if (act) animarSuave(p, 260, 4);
      });
    };
    const activarFaunaPag = (pag: string) => {
      cambiarFFTab("fauna");
      root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-pag]").forEach((b) => {
        b.classList.toggle("activo", b.dataset.mvFaunaPag === pag);
      });
      root.querySelectorAll<HTMLElement>("[data-mv-fauna-panel]").forEach((p) => {
        const act = p.dataset.mvFaunaPanel === pag;
        p.classList.toggle("activa", act);
        if (act) animarSuave(p, 260, 4);
      });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-pag]").forEach((b) => {
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        if (b.dataset.mvFloraPag) activarFloraPag(b.dataset.mvFloraPag);
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-pag]").forEach((b) => {
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        if (b.dataset.mvFaunaPag) activarFaunaPag(b.dataset.mvFaunaPag);
      });
    });

    const imgFlora = root.querySelector("#mv-img-flora") as HTMLImageElement | null;
    const lblFloraCom = root.querySelector("#mv-flora-comun");
    const lblFloraCie = root.querySelector("#mv-flora-cient");
    const renderFloraMovil = () => {
      const cat = CATALOGO_FLORA_MOVIL.find((c) => c.id === catFlora) || CATALOGO_FLORA_MOVIL[0];
      const item = cat.especies[idxFlora] || cat.especies[0];
      if (imgFlora) {
        imgFlora.style.objectPosition = item.posicionFoto || "center";
        if (imgFlora.getAttribute("src") !== item.foto) {
          imgFlora.src = item.foto;
          animarSuave(imgFlora, 260, 0);
        }
        imgFlora.alt = item.comun;
      }
      if (lblFloraCom) lblFloraCom.textContent = item.comun;
      if (lblFloraCie) lblFloraCie.textContent = item.cientifico;
      root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-cat]").forEach((b) => {
        b.classList.toggle("activo", b.dataset.mvFloraCat === catFlora);
      });
      root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-idx]").forEach((b) => {
        b.classList.toggle("activo", Number(b.dataset.mvFloraIdx) === idxFlora);
      });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-cat]").forEach((b) => {
      b.addEventListener("click", () => {
        if (!b.dataset.mvFloraCat) return;
        catFlora = b.dataset.mvFloraCat;
        idxFlora = 0;
        renderFloraMovil();
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-mv-flora-idx]").forEach((b) => {
      b.addEventListener("click", () => {
        idxFlora = Number(b.dataset.mvFloraIdx || 0);
        renderFloraMovil();
      });
    });

    const imgFauna = root.querySelector("#mv-img-fauna") as HTMLImageElement | null;
    const lblFaunaCom = root.querySelector("#mv-fauna-comun");
    const lblFaunaCie = root.querySelector("#mv-fauna-cient");
    const renderFaunaMovil = () => {
      const cat = CATALOGO_FAUNA_MOVIL.find((c) => c.id === catFauna) || CATALOGO_FAUNA_MOVIL[0];
      const item = cat.especies[idxFauna] || cat.especies[0];
      if (imgFauna) {
        imgFauna.style.objectPosition = item.posicionFoto || "center";
        if (imgFauna.getAttribute("src") !== item.foto) {
          imgFauna.src = item.foto;
          animarSuave(imgFauna, 260, 0);
        }
        imgFauna.alt = item.comun;
      }
      if (lblFaunaCom) lblFaunaCom.textContent = item.comun;
      if (lblFaunaCie) lblFaunaCie.textContent = item.cientifico;
      root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-cat]").forEach((b) => {
        b.classList.toggle("activo", b.dataset.mvFaunaCat === catFauna);
      });
      root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-idx]").forEach((b) => {
        b.classList.toggle("activo", Number(b.dataset.mvFaunaIdx) === idxFauna);
      });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-cat]").forEach((b) => {
      b.addEventListener("click", () => {
        if (!b.dataset.mvFaunaCat) return;
        catFauna = b.dataset.mvFaunaCat;
        idxFauna = 0;
        renderFaunaMovil();
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-mv-fauna-idx]").forEach((b) => {
      b.addEventListener("click", () => {
        idxFauna = Number(b.dataset.mvFaunaIdx || 0);
        renderFaunaMovil();
      });
    });

    // Guía del visitante: Rutas, Detalle y Modal Mapa
    let pagRutas = 0;
    let posLista = 0;
    let rutaActivaIdx = 0;
    let tabDetalle: "acceso" | "caracteristicas" | "advertencias" = "acceso";
    let galeriaIdx = 0;

    const btnsRutasPag = root.querySelectorAll<HTMLButtonElement>("[data-mv-rutas-pag]");
    const btnsRutaItem = root.querySelectorAll<HTMLButtonElement>("[data-mv-ruta-pos]");
    const imgRutaPreview = root.querySelector("#mv-img-ruta-preview") as HTMLImageElement | null;
    const btnVerRuta = root.querySelector("#mv-btn-ver-ruta");
    const btnVolverRutas = root.querySelector("#mv-btn-volver-rutas");

    const renderListaRutasMovil = () => {
      btnsRutasPag.forEach((b) => {
        const act = Number(b.dataset.mvRutasPag) === pagRutas;
        b.classList.toggle("activo", act);
        b.setAttribute("aria-selected", act ? "true" : "false");
      });
      const base = pagRutas * 4;
      btnsRutaItem.forEach((b, i) => {
        const r = RUTAS_PARQUE_MOVIL[base + i];
        const act = i === posLista;
        b.textContent = r.nombreLista;
        b.classList.toggle("activo", act);
        b.setAttribute("aria-selected", act ? "true" : "false");
      });
      rutaActivaIdx = base + posLista;
      const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
      if (imgRutaPreview && imgRutaPreview.getAttribute("src") !== ruta.fotoLista) {
        imgRutaPreview.src = ruta.fotoLista;
        imgRutaPreview.alt = `Vista previa de ${ruta.nombreLista}`;
        animarSuave(imgRutaPreview, 260, 0);
      }
    };

    btnsRutasPag.forEach((b) => {
      b.addEventListener("click", () => {
        pagRutas = Number(b.dataset.mvRutasPag || 0);
        posLista = 0;
        renderListaRutasMovil();
      });
    });
    btnsRutaItem.forEach((b) => {
      b.addEventListener("click", () => {
        posLista = Number(b.dataset.mvRutaPos || 0);
        renderListaRutasMovil();
      });
    });

    const elDetTitulo = root.querySelector("#mv-titulo-detalle-ruta");
    const elValDist = root.querySelector("#mv-val-dist");
    const elValDistNota = root.querySelector("#mv-val-dist-nota");
    const elValTiempo = root.querySelector("#mv-val-tiempo");
    const elValDif = root.querySelector("#mv-val-dif");
    const imgIconoDif = root.querySelector("#mv-icono-dif-ruta") as HTMLImageElement | null;
    const elDetDesc = root.querySelector("#mv-desc-detalle-ruta");
    const imgDetFoto = root.querySelector("#mv-img-ruta-detalle") as HTMLImageElement | null;
    const listBulletsDet = root.querySelector("#mv-lista-bullets-detalle");
    const btnsDetTab = root.querySelectorAll<HTMLButtonElement>("[data-mv-detalle-tab]");
    const btnsGaleria = root.querySelectorAll<HTMLButtonElement>("[data-mv-galeria-idx]");

    const renderBulletsMovil = () => {
      if (!listBulletsDet) return;
      const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
      const items = ruta[tabDetalle] || [];
      listBulletsDet.innerHTML = "";
      items.forEach((it) => {
        const li = document.createElement("li");
        li.className = "mv-prose";
        if (it.prefix) {
          const st = document.createElement("strong");
          st.textContent = `${tipografiaEditorial(it.prefix)} `;
          li.appendChild(st);
        }
        li.appendChild(document.createTextNode(tipografiaEditorial(it.texto)));
        listBulletsDet.appendChild(li);
      });
      animarSuave(listBulletsDet, 220, 3);
    };

    const renderGaleriaMovil = () => {
      const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
      btnsGaleria.forEach((b) => {
        b.classList.toggle("activo", Number(b.dataset.mvGaleriaIdx) === galeriaIdx);
      });
      const src = ruta.fotosDetalle[galeriaIdx] || ruta.fotosDetalle[0];
      if (imgDetFoto) {
        imgDetFoto.alt = `Fotografía ${galeriaIdx + 1} de ${ruta.nombreDetalle}`;
        if (imgDetFoto.getAttribute("src") !== src) {
          imgDetFoto.src = src;
          animarSuave(imgDetFoto, 260, 0);
        }
      }
    };

    const renderDetalleMovil = () => {
      const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
      if (elDetTitulo) elDetTitulo.textContent = ruta.nombreDetalle;
      if (elValDist) elValDist.textContent = ruta.distancia;
      if (elValDistNota) {
        elValDistNota.textContent = ruta.distanciaNota || "";
      }
      if (elValTiempo) elValTiempo.textContent = ruta.tiempo;
      if (elValDif) elValDif.textContent = ruta.dificultad;
      if (imgIconoDif) {
        imgIconoDif.src =
          ruta.dificultad === "Alta"
            ? "/elementos/svg/icono-ruta-dificultad-alta.svg"
            : "/elementos/svg/icono-ruta-dificultad-media.svg";
      }
      if (elDetDesc) elDetDesc.textContent = tipografiaEditorial(ruta.descripcion);
      btnsDetTab.forEach((b) => {
        const act = b.dataset.mvDetalleTab === tabDetalle;
        b.classList.toggle("activa", act);
        b.setAttribute("aria-selected", act ? "true" : "false");
      });
      renderBulletsMovil();
      renderGaleriaMovil();
    };

    if (btnVerRuta) {
      btnVerRuta.addEventListener("click", () => {
        rutaActivaIdx = pagRutas * 4 + posLista;
        tabDetalle = "acceso";
        galeriaIdx = 0;
        renderDetalleMovil();
        activarVistaEnSeccion("guia-visitante", "detalle-ruta");
      });
    }
    if (btnVolverRutas) {
      btnVolverRutas.addEventListener("click", () => {
        activarVistaEnSeccion("guia-visitante", "rutas-parque");
      });
    }
    btnsDetTab.forEach((b) => {
      b.addEventListener("click", () => {
        const t = b.dataset.mvDetalleTab as "acceso" | "caracteristicas" | "advertencias" | undefined;
        if (!t || t === tabDetalle) return;
        tabDetalle = t;
        btnsDetTab.forEach((btn) => {
          const act = btn === b;
          btn.classList.toggle("activa", act);
          btn.setAttribute("aria-selected", act ? "true" : "false");
        });
        renderBulletsMovil();
      });
    });
    btnsGaleria.forEach((b) => {
      b.addEventListener("click", () => {
        galeriaIdx = Number(b.dataset.mvGaleriaIdx || 0);
        renderGaleriaMovil();
      });
    });

    // Modal mapa móvil
    const modal = root.querySelector("#mv-modal-mapa");
    const btnVerMapa = root.querySelector("#mv-btn-ver-mapa");
    const btnCerrarMapa = root.querySelector("#mv-btn-cerrar-mapa");
    const iframeMapa = root.querySelector("#mv-iframe-mapa") as HTMLIFrameElement | null;
    const modalTit = root.querySelector("#mv-modal-titulo");
    const modalSub = root.querySelector("#mv-modal-subtitulo");
    const modalCoords = root.querySelector("#mv-modal-coords");
    const linkGmaps = root.querySelector("#mv-link-gmaps") as HTMLAnchorElement | null;
    let timerIframe: number | null = null;

    const cerrarMapa = () => {
      if (!modal) return;
      modal.classList.remove("abierto");
      if (timerIframe) clearTimeout(timerIframe);
      timerIframe = window.setTimeout(() => {
        if (!modal.classList.contains("abierto") && iframeMapa?.getAttribute("src")) {
          iframeMapa.removeAttribute("src");
        }
      }, 280);
    };

    if (btnVerMapa && modal) {
      btnVerMapa.addEventListener("click", () => {
        if (timerIframe) {
          clearTimeout(timerIframe);
          timerIframe = null;
        }
        const ruta = RUTAS_PARQUE_MOVIL[rutaActivaIdx];
        if (modalTit) modalTit.textContent = `Mapa: ${ruta.nombreDetalle}`;
        if (modalSub) modalSub.textContent = ruta.mapaAccesoCorto;
        if (modalCoords) modalCoords.textContent = `Coordenadas: ${ruta.mapaCoords}`;
        if (iframeMapa) {
          iframeMapa.src = `https://maps.google.com/maps?q=${encodeURIComponent(ruta.mapaCoords)}&z=14&output=embed`;
        }
        if (linkGmaps) {
          linkGmaps.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ruta.mapaCoords)}`;
        }
        modal.classList.add("abierto");
      });
    }
    if (btnCerrarMapa) btnCerrarMapa.addEventListener("click", cerrarMapa);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) cerrarMapa();
      });
    }

    // Paginadores genéricos (Emergencias y Normativa)
    root.querySelectorAll<HTMLButtonElement>("[data-mv-grupo][data-mv-pag-idx]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const g = btn.dataset.mvGrupo;
        const idx = btn.dataset.mvPagIdx;
        if (!g || idx === undefined) return;
        root.querySelectorAll<HTMLButtonElement>(`[data-mv-grupo="${g}"][data-mv-pag-idx]`).forEach((b) => {
          b.classList.toggle("activo", b.dataset.mvPagIdx === idx);
        });
        root.querySelectorAll<HTMLElement>(`[data-mv-panel-grupo="${g}"][data-mv-pag-idx]`).forEach((p) => {
          const act = p.dataset.mvPagIdx === idx;
          p.classList.toggle("activa", act);
          if (act) animarSuave(p, 260, 4);
        });
      });
    });

    // Contactos de emergencia
    const tabsContacto = root.querySelectorAll<HTMLButtonElement>("[data-mv-contacto-target]");
    const panesContacto = root.querySelectorAll<HTMLElement>("[data-mv-contacto-pane]");
    tabsContacto.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.mvContactoTarget;
        tabsContacto.forEach((b) => b.classList.toggle("activa", b === btn));
        panesContacto.forEach((p) => {
          const act = p.dataset.mvContactoPane === target;
          p.classList.toggle("activa", act);
          if (act) animarSuave(p, 240, 3);
        });
      });
    });

    // Soporte URL (?vista=...)
    const params = new URLSearchParams(window.location.search);
    const vParam = params.get("vista");
    if (vParam) {
      const secId = root.dataset.seccionActiva || "quienes-somos";
      const targetBtn = root.querySelector<HTMLButtonElement>(
        `.mv-grupo-maderas[data-mv-maderas-sec="${secId}"] .mv-madera-btn[data-mv-vista-target="${vParam}"]`
      );
      if (targetBtn) {
        activarVistaEnSeccion(secId, vParam, targetBtn.dataset.mvVistaBg);
      }
    }
  }

  document.addEventListener("DOMContentLoaded", inicializarVistaMovil);
  inicializarVistaMovil();
</script>

