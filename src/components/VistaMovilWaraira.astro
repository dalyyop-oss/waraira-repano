          imgCumbre.alt = btn.dataset.mvCumbreNombre || "";
          animarSuave(imgCumbre, 260, 0);
        }
        if (descCumbre) descCumbre.textContent = btn.dataset.mvCumbreDesc || "";
        if (altCumbre) altCumbre.textContent = btn.dataset.mvCumbreAltura || "";
      });
