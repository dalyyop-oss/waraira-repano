      });
    }
    btnsDetTab.forEach((b) => {
      b.addEventListener("click", () => {
        const t = b.dataset.mvDetalleTab as "acceso" | "caracteristicas" | "advertencias" | undefined;
        if (!t || t === tabDetalle) return;
        tabDetalle = t;
        btnsDetTab.forEach((btn) => {
          const act = btn === b;
          btn.classList.toggle("activa", act);
          btn.setAttribute("aria-selected", act ? "true" : "false");
        });
        renderBulletsMovil();
