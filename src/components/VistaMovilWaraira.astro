<script>
  import {
    CATALOGO_FLORA_MOVIL,
    CATALOGO_FAUNA_MOVIL,
    RUTAS_PARQUE_MOVIL,
  } from "../data/warairaContenido";

  function inicializarVistaMovil() {
    const root = document.getElementById("waraira-vista-movil") as HTMLElement | null;
    if (!root || root.dataset.inicializado === "1") return;
    root.dataset.inicializado = "1";

    const imgFondoActual = root.querySelector(".mv-fondo-actual") as HTMLImageElement | null;
    const imgFondoAnterior = root.querySelector(".mv-fondo-anterior") as HTMLImageElement | null;
    const imgLomita = root.querySelector(".mv-lomita-svg") as HTMLImageElement | null;
    const imgEsquina = root.querySelector(".mv-esquina-izq") as HTMLImageElement | null;
    const lblModuloBar = root.querySelector(".mv-titulo-modulo-bar");

    const tabsTecho = root.querySelectorAll<HTMLButtonElement>(".mv-techo-tab[data-mv-sec]");
    const gruposMaderas = root.querySelectorAll<HTMLElement>(".mv-grupo-maderas[data-mv-maderas-sec]");
    const secciones = root.querySelectorAll<HTMLElement>(".mv-seccion[data-mv-seccion]");
    const btnMarcaPrincipal = root.querySelector(".mv-btn-letrero-principal");

    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const animarSuave = (el: Element | null, dur = 320, fromY = 6) => {
      if (!el || reduceMotion()) return;
      el.getAnimations().forEach((a) => a.cancel());
      el.animate(
        [
          { opacity: 0.12, transform: fromY ? `translateY(${fromY}px)` : "none" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: dur, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
      );
    };

    const cacheImagenes = new Map<string, HTMLImageElement>();
    const precargarImg = (src: string) => {
      let cached = cacheImagenes.get(src);
      if (!cached) {
        cached = new Image();
        cached.src = src;
        cacheImagenes.set(src, cached);
      }
      return cached;
    };

    let tokenFondo = 0;
    const cambiarFondoMovil = (nuevoBg?: string) => {
      if (!imgFondoActual || !nuevoBg || imgFondoActual.getAttribute("src") === nuevoBg) return;
      const miToken = ++tokenFondo;
      if (imgFondoAnterior) {
        imgFondoAnterior.src = imgFondoActual.getAttribute("src") || nuevoBg;
      }
      const cached = precargarImg(nuevoBg);
      const aplicar = () => {
        if (miToken !== tokenFondo) return;
        imgFondoActual.getAnimations().forEach((a) => a.cancel());
        imgFondoActual.src = nuevoBg;
        if (!reduceMotion()) {
          imgFondoActual.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          );
        }
      };
      if (cached.complete && cached.naturalWidth > 0) aplicar();
      else {
        cached.addEventListener("load", aplicar, { once: true });
        cached.addEventListener("error", aplicar, { once: true });
      }
    };

    // Precarga de fotos de especies y rutas
    CATALOGO_FLORA_MOVIL.forEach((c) => c.especies.forEach((e) => precargarImg(e.foto)));
    CATALOGO_FAUNA_MOVIL.forEach((c) => c.especies.forEach((e) => precargarImg(e.foto)));
    RUTAS_PARQUE_MOVIL.forEach((r) => {
      precargarImg(r.fotoLista);
      r.fotosDetalle.forEach((f) => precargarImg(f));
    });

    function activarVistaEnSeccion(secId: string, vistaId: string, fondoCustom?: string) {
      const secEl = root.querySelector<HTMLElement>(`.mv-seccion[data-mv-seccion="${secId}"]`);
      if (!secEl) return;

      secEl.dataset.mvVistaActual = vistaId;
      secEl.querySelectorAll<HTMLElement>(".mv-vista[data-mv-vista]").forEach((v) => {
        const esAct = v.dataset.mvVista === vistaId;
        v.classList.toggle("activa", esAct);
        if (esAct) animarSuave(v, 320, 6);
      });

      const madTarget = vistaId === "detalle-ruta" ? "rutas-parque" : vistaId;
      const grupo = root.querySelector(`.mv-grupo-maderas[data-mv-maderas-sec="${secId}"]`);
      if (grupo) {
        grupo.querySelectorAll<HTMLButtonElement>(".mv-madera-btn").forEach((b) => {
          const activa = b.dataset.mvVistaTarget === madTarget;
          b.classList.toggle("activa", activa);
          if (activa) {
            b.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          }
        });
      }

      if (fondoCustom) {
        cambiarFondoMovil(fondoCustom);
      }
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    }

    function cambiarSeccionMovil(secId: string, propagar = true) {
      const tab = Array.from(tabsTecho).find((t) => t.dataset.mvSec === secId);
      if (!tab) return;

      root.dataset.seccionActiva = secId;
      const color = tab.dataset.mvColor || "#ff8f00";
      const oscuro = tab.dataset.mvOscuro || "#cc6f00";
      root.style.setProperty("--mv-tema", color);
      root.style.setProperty("--mv-tema-oscuro", oscuro);

      if (lblModuloBar && tab.dataset.mvTitulo) {
        lblModuloBar.textContent = tab.dataset.mvTitulo;
      }
      if (imgLomita && tab.dataset.mvLomita && imgLomita.getAttribute("src") !== tab.dataset.mvLomita) {
        imgLomita.src = tab.dataset.mvLomita;
      }
      if (imgEsquina && tab.dataset.mvEsquina && imgEsquina.getAttribute("src") !== tab.dataset.mvEsquina) {
        imgEsquina.src = tab.dataset.mvEsquina;
      }

      tabsTecho.forEach((t) => {
        const act = t.dataset.mvSec === secId;
        t.classList.toggle("activa", act);
        t.setAttribute("aria-pressed", act ? "true" : "false");
      });

      gruposMaderas.forEach((g) => {
        g.classList.toggle("activo", g.dataset.mvMaderasSec === secId);
      });

      secciones.forEach((s) => {
        const esAct = s.dataset.mvSeccion === secId;
        s.classList.toggle("activa", esAct);
        if (esAct) animarSuave(s, 340, 6);
      });

      const secEl = root.querySelector<HTMLElement>(`.mv-seccion[data-mv-seccion="${secId}"]`);
      const vistaActual = secEl?.dataset.mvVistaActual || "intro";
      const btnMadera = root.querySelector<HTMLButtonElement>(
        `.mv-grupo-maderas[data-mv-maderas-sec="${secId}"] .mv-madera-btn[data-mv-vista-target="${vistaActual}"]`
      );
      cambiarFondoMovil(btnMadera?.dataset.mvVistaBg || tab.dataset.mvFondo);

      if (propagar) {
        window.dispatchEvent(
          new CustomEvent("waraira:seccion-cambiada", {
            detail: { seccion: secId, origen: "movil" },
          })
        );
      }
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    }

    tabsTecho.forEach((tab) => {
      tab.addEventListener("click", () => {
        const destino = tab.dataset.mvSec;
        if (destino) cambiarSeccionMovil(destino, true);
      });
    });

    if (btnMarcaPrincipal) {
      btnMarcaPrincipal.addEventListener("click", () => {
        const secId = root.dataset.seccionActiva || "quienes-somos";
        const tab = root.querySelector<HTMLButtonElement>(`.mv-techo-tab[data-mv-sec="${secId}"]`);
        activarVistaEnSeccion(secId, "intro", tab?.dataset.mvFondo);
      });
    }

    gruposMaderas.forEach((grupo) => {
