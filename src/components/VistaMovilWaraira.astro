    const btnsCumbre = root.querySelectorAll<HTMLButtonElement>("[data-mv-cumbre-foto]");
    const imgCumbre = root.querySelector("#mv-img-cumbre") as HTMLImageElement | null;
    const descCumbre = root.querySelector("#mv-desc-cumbre");
