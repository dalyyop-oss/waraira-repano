<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modulos = document.querySelectorAll<HTMLElement>(".modulo-emergencias");

    modulos.forEach((root) => {
      const botonesLetrero = root.querySelectorAll<HTMLButtonElement>("[data-vista-target]");
      const vistas = root.querySelectorAll<HTMLElement>(".vista-panel[data-vista]");

      function activarVista(id: string) {
        vistas.forEach((v) => v.classList.toggle("activa", v.dataset.vista === id));
        botonesLetrero.forEach((btn) => {
          btn.classList.toggle("activo", btn.dataset.vistaTarget === id);
        });
      }

      botonesLetrero.forEach((btn) => {
        btn.addEventListener("click", () => {
          const destino = btn.dataset.vistaTarget || "intro";
          activarVista(destino);
        });
      });

      function activarPag(grupo: string, idx: string) {
        root.querySelectorAll<HTMLButtonElement>(`.btn-dot-emergencias[data-pag-grupo="${grupo}"]`).forEach((b) => {
          const esActiva = b.dataset.pagIdx === idx;
          b.classList.toggle("activo", esActiva);
          b.setAttribute("aria-selected", esActiva ? "true" : "false");
        });

        root.querySelectorAll<HTMLElement>(`[data-pag-contenido="${grupo}"]`).forEach((panel) => {
          panel.classList.toggle("activa", panel.dataset.pagIdx === idx);
        });
      }

      // Paginadores internos de puntos
      const dotButtons = root.querySelectorAll<HTMLButtonElement>(".btn-dot-emergencias[data-pag-grupo]");
      dotButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const grupo = btn.dataset.pagGrupo;
          const idx = btn.dataset.pagIdx;
          if (!grupo || idx === undefined) return;
          activarPag(grupo, idx);
        });
      });

      // Selector de Contactos de emergencia (Protección civil / Bomberos / INPARQUES)
      const tabsContacto = root.querySelectorAll<HTMLButtonElement>("[data-contacto-target]");
      const panesContacto = root.querySelectorAll<HTMLElement>("[data-contacto-pane]");

      function activarContacto(target: string) {
        tabsContacto.forEach((t) => t.classList.toggle("activa", t.dataset.contactoTarget === target));
        panesContacto.forEach((p) => p.classList.toggle("activa", p.dataset.contactoPane === target));
      }

      tabsContacto.forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = tab.dataset.contactoTarget;
          if (!target) return;
          activarContacto(target);
        });
      });

      // Soporte opcional de URL params (?vista=...&pag=...&contacto=...)
      const params = new URLSearchParams(window.location.search);
      const vistaParam = params.get("vista");
      if (vistaParam) {
        activarVista(vistaParam);
        const pagParam = params.get("pag");
        const mapaGrupo: Record<string, string> = {
          "prepara-ascenso": "prepara",
          "urgencias-medicas": "urgencias",
          "golpes-heridas": "golpes",
          "incendio-forestal": "incendio",
        };
        if (pagParam !== null && mapaGrupo[vistaParam]) {
          activarPag(mapaGrupo[vistaParam], pagParam);
        }
        const contactoParam = params.get("contacto");
        if (contactoParam && vistaParam === "contactos-emergencia") {
          activarContacto(contactoParam);
        }
      }
    });
  });
</script>

