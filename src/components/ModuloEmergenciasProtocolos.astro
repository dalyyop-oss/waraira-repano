---

<section class="modulo-emergencias" aria-label="Módulo Emergencias y protocolos">
  <EstructuraCuadrados tema="turquesa" fondoInicial="/fondos/bg-emergencias.webp">
    <!-- Techo superior -->
    <Techo seccionActiva="emergencias" />

    <!-- Letrero lateral vertical de madera -->
    <CabezalVertical tema="turquesa" itemActivo="intro" items={itemsMenuEmergencias} />

    <!-- Hierba decorativa esquina inferior derecha -->
    <img
      src="/elementos/hojas-decorativas-derecha-emergencias.webp"
      alt=""
      aria-hidden="true"
      class="decorativo-derecha-emergencias"
      draggable="false"
    />

    <!-- ============================================================
         VISTA 0: PORTADA INTRODUCTORIA (PDF Pág. 50)
         ============================================================ -->
    <div class="vista-panel activa" data-vista="intro">
      <div class="tarjeta-svg-intro" style="left: 332px; top: 119px; width: 642.26px; height: 351.84px;">
        <img src="/elementos/svg/contenedor-emergencias-intro.svg" alt="" class="fondo-svg-tarjeta" draggable="false" />
        <div class="contenido-sobre-svg">
          <h1 class="titulo-pestana-intro-turquesa" style="left: 38.26px; top: 17px;">
            Emergencias y protocolos
          </h1>
          <div class="cuerpo-19pt texto-blanco texto-intro-emergencias">
            <p>
              Recorrer el Waraira Repano es una experiencia enriquecedora,<br />
              pero la montaña exige respeto y cautela. Ante variaciones del<br />
              clima, extravíos o emergencias médicas, la prevención es tu<br />
              mejor herramienta.
            </p>
            <p class="mt-23">
              Revisa nuestros protocolos paso a paso, conoce las<br />
              recomendaciones de los cuerpos de rescate y asegúrate de<br />
              contar con la información necesaria para reaccionar de manera<br />
              rápida y coordinada.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         VISTA 1: PREPARA TU ASCENSO (PDF Págs. 51–53)
         ============================================================ -->
    <div class="vista-panel" data-vista="prepara-ascenso">
      <img
        src="/elementos/svg/contenedor-prepara-ascenso.svg"
        alt=""
        class="svg-superior-709"
        draggable="false"
      />
      <h2 class="titulo-pestana-superior">Prepara tu ascenso</h2>

      <!-- Paginador de 3 puntos dentro de la cápsula blanca -->
      <div class="paginador-pill pag-3" data-pag-grupo="prepara" role="tablist" aria-label="Páginas de Prepara tu ascenso">
        {[0, 1, 2].map((i) => (
          <button
            type="button"
            class:list={["btn-dot-emergencias", { activo: i === 0 }]}
            data-pag-grupo="prepara"
            data-pag-idx={String(i)}
            aria-label={`Prepara tu ascenso página ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          >
            <img
              class="dot-img-activo"
              src="/elementos/svg/dot-emergencias-activo.svg"
              alt=""
              draggable="false"
            />
            <img
              class="dot-img-inactivo"
              src="/elementos/svg/dot-emergencias-inactivo.svg"
              alt=""
              draggable="false"
            />
          </button>
        ))}
      </div>

      {PREPARA_PAGINAS.map((pag, idx) => (
        <div
          class:list={["subpagina-grupo", { activa: idx === 0 }]}
          data-pag-contenido="prepara"
          data-pag-idx={String(idx)}
        >
          <p class="lead-superior" style={`left: ${pag.xLead}px; top: 213.43px; white-space: nowrap;`}>
            {pag.leadLineas.map((linea, lIdx) => (
              <>
                {linea}
                {lIdx < pag.leadLineas.length - 1 && <br />}
              </>
            ))}
          </p>
          <img
            src={pag.cardsSvg}
            alt=""
            class:list={[pag.tresCards ? "svg-cards-3" : "svg-cards-4"]}
            draggable="false"
          />
          {pag.items.map((item) => (
            <p
              class="texto-card-prepara"
              style={`left: ${item.x}px; top: ${item.y}px;`}
            >
              {item.lineas.map((linea, lIdx) => (
                <>
                  {linea}
                  {lIdx < item.lineas.length - 1 && <br />}
                </>
              ))}
            </p>
          ))}
        </div>
      ))}
    </div>

    <!-- ============================================================
         VISTA 2: PROTOCOLO ANTE EXTRAVÍO (PDF Pág. 54)
         ============================================================ -->
    <div class="vista-panel" data-vista="protocolo-extravio">
      <img
        src="/elementos/svg/contenedor-protocolo-extravio.svg"
        alt=""
        class="svg-superior-709"
        draggable="false"
      />
      <img
        src="/elementos/svg/contenedor-textos-inferior.svg"
        alt=""
        class="svg-inferior-638"
