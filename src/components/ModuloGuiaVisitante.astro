    ],
    acceso: [{ texto: "Altamira, 10ma Transversal (entre 2da y 3ra Avenida)." }],
    caracteristicas: [
      { prefix: "Puesto de guardaparques:", texto: "Sabas Nieves I y II / incluyen punto de hidratación." },
      { texto: "Incluye la escalera de 72 peldaños." },
