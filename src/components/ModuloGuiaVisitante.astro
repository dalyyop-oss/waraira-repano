---
import EstructuraCuadrados from "./EstructuraCuadrados.astro";
import Techo from "./Techo.astro";
import CabezalVertical, { type ItemLetrero } from "./CabezalVertical.astro";

const itemsMenuGuia: ItemLetrero[] = [
  {
    id: "rutas-parque",
    etiqueta: "Rutas del parque",
    inactivo: "/elementos/botones/madera-inactiva-rutas-parque.svg",
    activo: "/elementos/botones/madera-activa-rutas-parque.svg",
    mostrarTexto: true,
  },
];

interface BulletItem {
  prefix?: string;
  texto: string;
}

interface RutaParque {
  slug: string;
  nombreLista: string;
  nombreDetalle: string;
  distancia: string;
  distanciaNota?: string;
  tiempo: string;
  dificultad: "Media" | "Alta";
  descripcionLineas: string[];
  acceso: BulletItem[];
  caracteristicas: BulletItem[];
  advertencias: BulletItem[];
  fotoLista: string;
  fotosDetalle: [string, string, string];
  mapaCoords: string;
  mapaAccesoCorto: string;
}

const RUTAS_PARQUE: RutaParque[] = [
  {
    slug: "galipan-via-cotiza",
    nombreLista: "Galipán Vía Cotiza",
    nombreDetalle: "Galipán vía Cotiza",
    distancia: "17,55 km",
    tiempo: "2 a 3 horas",
    dificultad: "Media",
    descripcionLineas: [
      "Ruta que asciende al poblado de Galipán, famoso por sus cultivos de",
      "flores y fresas. Pasa por el área recreativa Los Venados y conecta con el",
      "Hotel Humboldt y la estación del Teleférico.",
    ],
    acceso: [
      { texto: "Cotiza, Av. Peñalver (entre San Bernardino y Cotiza)." },
      { texto: "Se puede acceder en vehículo 4x4 o a pie." },
    ],
    caracteristicas: [
      { prefix: "Puesto de guardaparques:", texto: "Cotiza / Los Venados." },
      { prefix: "Punto de hidratación:", texto: "Los Venados / Galipán." },
    ],
    advertencias: [
      { texto: "Clima con abundante niebla." },
      { texto: "Vía vehicular estrecha y sinuosa." },
    ],
    fotoLista: "/fotos/rutas/galipan-lista.webp",
    fotosDetalle: [
      "/fotos/rutas/galipan-detalle-1.webp",
      "/fotos/rutas/galipan-detalle-2.webp",
      "/fotos/rutas/galipan-detalle-3.webp",
    ],
    mapaCoords: "10.5625,-66.8980",
    mapaAccesoCorto: "Cotiza, Av. Peñalver → Los Venados → Galipán",
  },
  {
    slug: "camino-de-los-espanoles",
    nombreLista: "Camino de los Españoles",
    nombreDetalle: "Camino de los Españoles",
    distancia: "8 km",
    tiempo: "3 a 4 horas",
    dificultad: "Media",
    descripcionLineas: [
      "Ruta histórica colonial construida en el siglo XVIII para conectar Caracas",
      "con el puerto de La Guaira.",
      "Es un camino empedrado original que pasa por las ruinas de los fortines",
      "Castillo Negro y Castillo Blanco, patrimonio histórico de Venezuela.",
    ],
    acceso: [{ texto: "Puerta Caracas, sector La Pastora." }],
    caracteristicas: [
      { prefix: "Puesto de guardaparques:", texto: "Puerta de Caracas / Quenepe." },
      { prefix: "Punto de hidratación:", texto: "La Posada." },
    ],
    advertencias: [
      { texto: "Exposición solar alta en primer tramo." },
      { texto: "Tramos empedrados irregulares debido a los restos coloniales." },
    ],
    fotoLista: "/fotos/rutas/camino-espanoles-lista.webp",
    fotosDetalle: [
