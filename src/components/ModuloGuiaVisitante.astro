];
---

<section class="modulo-guia-visitante" data-vista-actual="intro">
  <EstructuraCuadrados tema="verde" fondoInicial="/fondos/bg-guia-visitante.webp">
    <Techo seccionActiva="guia-visitante" />
    <CabezalVertical tema="verde" items={itemsMenuGuia} itemActivo="intro" />

    <!-- Elemento decorativo derecho: rama con hojas verdes (visible en Intro y Rutas del Parque) -->
    <img
      src="/elementos/rama-guia-derecha.webp"
      alt=""
      aria-hidden="true"
      class="rama-guia-derecha activa"
      draggable="false"
    />

    <!-- ========================================================== -->
    <!-- VISTA 0: PORTADA INTRO (PDF semana 5 pág. 41)               -->
    <!-- ========================================================== -->
    <div class="vista-panel activa" data-vista="intro">
      <img
        src="/elementos/svg/contenedor-guia-intro.svg"
        alt=""
        aria-hidden="true"
        class="svg-intro-guia"
        draggable="false"
      />
      <h1 class="titulo-intro-guia">Guía del visitante</h1>
      <div class="texto-intro-guia">
        <p class="intro-p1">
          El Parque Nacional Waraira Repano te espera con caminos<br />
          llenos de historia, vegetación única y paisajes inolvidables. La<br />
          Guía al Visitante es tu herramienta definitiva para explorar cada<br />
          rincón de forma segura, planificada y emocionante.
        </p>
        <p class="intro-p2">
          Estas rutas han sido trazadas pensando exclusivamente en los<br />
          amantes del senderismo.
        </p>
      </div>
    </div>

    <!-- ========================================================== -->
    <!-- VISTA 1: RUTAS DEL PARQUE (PDF semana 5 págs. 42–49)       -->
    <!-- ========================================================== -->
    <div class="vista-panel" data-vista="rutas-parque">
      <img
        src="/elementos/svg/contenedor-rutas-superior.svg"
        alt=""
        aria-hidden="true"
        class="svg-rutas-superior"
        draggable="false"
      />
      <h1 class="titulo-pestana-rutas">Rutas del Parque</h1>

      <div class="paginador-rutas" role="tablist" aria-label="Páginas de rutas del parque">
        {[0, 1].map((pag) => (
          <button
            type="button"
            class:list={["btn-dot-guia", { activo: pag === 0 }]}
            data-pag-rutas={String(pag)}
            aria-label={`Rutas página ${pag + 1}`}
            aria-selected={pag === 0 ? "true" : "false"}
          >
            <img class="dot-img-activo" src="/elementos/svg/dot-guia-activo.svg" alt="" draggable="false" />
            <img class="dot-img-inactivo" src="/elementos/svg/dot-guia-inactivo.svg" alt="" draggable="false" />
          </button>
        ))}
      </div>

      <p class="lead-rutas-parque">
        Descubre las rutas de nuestro parque y conéctate con la naturaleza.
      </p>

      <!-- Contenedores SVG dinámicos según la fila seleccionada (0..3) -->
      {[1, 2, 3, 4].map((num, idx) => (
        <img
          src={`/elementos/svg/contenedor-rutas-lista-${num}.svg`}
          alt=""
          aria-hidden="true"
          class:list={["svg-rutas-lista", { activa: idx === 0 }]}
          data-svg-lista-idx={String(idx)}
          draggable="false"
        />
      ))}

      <!-- 4 botones interactivos de rutas visibles en la página actual -->
      <div class="lista-botones-rutas" role="listbox" aria-label="Listado de rutas">
        {RUTAS_PARQUE.slice(0, 4).map((r, idx) => (
          <button
            type="button"
            class:list={["btn-ruta-item", { activo: idx === 0 }]}
            data-lista-pos={String(idx)}
            role="option"
            aria-selected={idx === 0 ? "true" : "false"}
          >
            {r.nombreLista}
          </button>
        ))}
      </div>

      <!-- Visor derecho con UNA sola imagen dinámica precargada (cero parpadeos) -->
      <div class="marco-foto-lista">
        <img
          src={RUTAS_PARQUE[0].fotoLista}
          alt={`Vista previa de la ruta ${RUTAS_PARQUE[0].nombreLista}`}
          class="foto-ruta-preview"
          draggable="false"
        />
      </div>

      <button type="button" class="btn-ver-ruta">
        Ver ruta
      </button>
    </div>

    <!-- ========================================================== -->
    <!-- VISTA 2: DETALLE DE RUTA (PDF rutas-de-guia págs. 4–27)    -->
    <!-- ========================================================== -->
    <div class="vista-panel" data-vista="detalle-ruta">
      <img
        src="/elementos/svg/contenedor-ruta-detalle-base.svg"
        alt=""
        aria-hidden="true"
        class="svg-detalle-base"
        draggable="false"
      />

      <h1 class="titulo-detalle-ruta">{RUTAS_PARQUE[0].nombreDetalle}</h1>

      <!-- Métricas superiores -->
      <img
        src="/elementos/svg/icono-ruta-distancia.svg"
        alt=""
        aria-hidden="true"
        class="icono-metrica icono-distancia"
        draggable="false"
      />
      <span class="label-metrica label-distancia">Distancia</span>
      <span class="valor-metrica valor-distancia">
        <span class="valor-distancia-num">{RUTAS_PARQUE[0].distancia}</span>
        <span class="distancia-nota" style="display: none;"></span>
      </span>

      <img
        src="/elementos/svg/icono-ruta-tiempo.svg"
        alt=""
        aria-hidden="true"
        class="icono-metrica icono-tiempo"
        draggable="false"
      />
      <span class="label-metrica label-tiempo">Tiempo de recorrido</span>
      <span class="valor-metrica valor-tiempo">{RUTAS_PARQUE[0].tiempo}</span>

      <img
        src="/elementos/svg/icono-ruta-dificultad-media.svg"
        alt=""
        aria-hidden="true"
        class="icono-metrica icono-dificultad activa"
        data-icono-dif="Media"
        draggable="false"
      />
      <img
        src="/elementos/svg/icono-ruta-dificultad-alta.svg"
        alt=""
        aria-hidden="true"
        class="icono-metrica icono-dificultad"
        data-icono-dif="Alta"
        draggable="false"
      />
      <span class="label-metrica label-dificultad">Dificultad</span>
      <span class="valor-metrica valor-dificultad">{RUTAS_PARQUE[0].dificultad}</span>

      <!-- Descripción principal de la ruta -->
      <p class="descripcion-detalle-ruta">
        {RUTAS_PARQUE[0].descripcionLineas.map((linea, i) => (
          <>
            {linea}
            {i < RUTAS_PARQUE[0].descripcionLineas.length - 1 && <br />}
          </>
        ))}
      </p>

      <!-- Pestañas inferiores conectadas (Acceso, Características, Advertencias, Ver mapa) -->
      <img
        src="/elementos/svg/contenedor-ruta-tab-acceso.svg"
        alt=""
        aria-hidden="true"
        class="svg-detalle-tab activa"
        data-svg-tab="acceso"
        draggable="false"
      />
      <img
        src="/elementos/svg/contenedor-ruta-tab-caracteristicas.svg"
        alt=""
        aria-hidden="true"
        class="svg-detalle-tab"
        data-svg-tab="caracteristicas"
        draggable="false"
      />
      <img
        src="/elementos/svg/contenedor-ruta-tab-advertencias.svg"
        alt=""
        aria-hidden="true"
        class="svg-detalle-tab"
        data-svg-tab="advertencias"
        draggable="false"
      />

      <div class="botones-detalle-tabs" role="tablist" aria-label="Información de la ruta">
        <button
          type="button"
          class="btn-detalle-tab tab-acceso activo"
          data-tab-target="acceso"
          role="tab"
          aria-selected="true"
        >
          Acceso
        </button>
        <button
          type="button"
          class="btn-detalle-tab tab-caracteristicas"
          data-tab-target="caracteristicas"
          role="tab"
          aria-selected="false"
        >
          Características
        </button>
        <button
          type="button"
          class="btn-detalle-tab tab-advertencias"
          data-tab-target="advertencias"
          role="tab"
          aria-selected="false"
        >
          Advertencias
        </button>
        <button type="button" class="btn-ver-mapa">
          Ver mapa
        </button>
      </div>

      <!-- Contenido de la burbuja verde (viñetas alineadas a la izquierda) -->
      <ul class="lista-bullets-detalle">
        {RUTAS_PARQUE[0].acceso.map((b) => (
          <li>
            <span class="bullet-punto" aria-hidden="true">•</span>
            <span class="bullet-contenido">
              {b.prefix && <strong>{b.prefix} </strong>}
              {b.texto}
            </span>
          </li>
        ))}
      </ul>

      <!-- Marco de foto vertical derecho + puntos de galería -->
      <div class="marco-foto-detalle">
        <img
          src={RUTAS_PARQUE[0].fotosDetalle[0]}
          alt={`Fotografía de la ruta ${RUTAS_PARQUE[0].nombreDetalle}`}
          class="foto-ruta-detalle"
          draggable="false"
        />
      </div>

      <div class="paginador-galeria" role="tablist" aria-label="Fotografías de la ruta">
        {[0, 1, 2].map((gIdx) => (
          <button
            type="button"
            class:list={["btn-dot-galeria", { activo: gIdx === 0 }]}
            data-galeria-idx={String(gIdx)}
            aria-label={`Foto ${gIdx + 1} de 3`}
            aria-selected={gIdx === 0 ? "true" : "false"}
          >
            <img class="dot-img-activo" src="/elementos/svg/dot-galeria-activo.svg" alt="" draggable="false" />
            <img class="dot-img-inactivo" src="/elementos/svg/dot-galeria-inactivo.svg" alt="" draggable="false" />
          </button>
        ))}
      </div>
    </div>

    <!-- Modal interactivo "Ver mapa" -->
    <div class="modal-mapa-overlay" role="dialog" aria-modal="true" aria-labelledby="titulo-modal-mapa">
      <div class="modal-mapa-card">
        <header class="modal-mapa-header">
          <div class="modal-mapa-titulos">
            <h2 id="titulo-modal-mapa" class="modal-mapa-titulo">Mapa de la ruta</h2>
            <p class="modal-mapa-subtitulo"></p>
          </div>
          <button type="button" class="btn-cerrar-mapa" aria-label="Cerrar mapa">×</button>
        </header>
        <div class="modal-mapa-cuerpo">
          <iframe
            class="iframe-mapa-ruta"
            title="Ubicación de la ruta en el Parque Nacional Waraira Repano"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <footer class="modal-mapa-footer">
          <span class="modal-mapa-coords"></span>
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-abrir-gmaps"
          >
            Abrir en Google Maps
          </a>
        </footer>
      </div>
    </div>
  </EstructuraCuadrados>
</section>

<script define:vars={{ rutasData: RUTAS_PARQUE }}>
  function inicializarModuloGuia() {
    const modulos = document.querySelectorAll(".modulo-guia-visitante");

    modulos.forEach((root) => {
      if (root.dataset.inicializado === "1") return;
      root.dataset.inicializado = "1";

      const botonesLetrero = root.querySelectorAll("[data-vista-target]");
      const vistas = root.querySelectorAll(".vista-panel[data-vista]");
      const ramaDerecha = root.querySelector(".rama-guia-derecha");

      // Estado Lista (Vista 1)
      const dotsPagina = root.querySelectorAll(".btn-dot-guia[data-pag-rutas]");
      const svgsLista = root.querySelectorAll(".svg-rutas-lista[data-svg-lista-idx]");
      const botonesLista = root.querySelectorAll(".btn-ruta-item[data-lista-pos]");
      const imgPreviewLista = root.querySelector(".foto-ruta-preview");
      const btnVerRuta = root.querySelector(".btn-ver-ruta");

      // Estado Detalle (Vista 2)
      const elTituloDetalle = root.querySelector(".titulo-detalle-ruta");
      const elDistNum = root.querySelector(".valor-distancia-num");
      const elDistNota = root.querySelector(".distancia-nota");
      const elTiempo = root.querySelector(".valor-tiempo");
      const elDif = root.querySelector(".valor-dificultad");
      const iconosDif = root.querySelectorAll(".icono-dificultad[data-icono-dif]");
      const elDescripcion = root.querySelector(".descripcion-detalle-ruta");
      const svgsDetalleTab = root.querySelectorAll(".svg-detalle-tab[data-svg-tab]");
      const botonesDetalleTab = root.querySelectorAll(".btn-detalle-tab[data-tab-target]");
      const listaBullets = root.querySelector(".lista-bullets-detalle");
      const imgFotoDetalle = root.querySelector(".foto-ruta-detalle");
      const dotsGaleria = root.querySelectorAll(".btn-dot-galeria[data-galeria-idx]");
      const btnVerMapa = root.querySelector(".btn-ver-mapa");

      // Modal Mapa
      const modalOverlay = root.querySelector(".modal-mapa-overlay");
      const modalTitulo = root.querySelector(".modal-mapa-titulo");
      const modalSubtitulo = root.querySelector(".modal-mapa-subtitulo");
      const modalIframe = root.querySelector(".iframe-mapa-ruta");
      const modalCoordsTxt = root.querySelector(".modal-mapa-coords");
      const modalLinkGmaps = root.querySelector(".btn-abrir-gmaps");
      const btnCerrarMapa = root.querySelector(".btn-cerrar-mapa");

      let pagActual = 0; // 0 (rutas 0..3) o 1 (rutas 4..7)
      let posListaActual = 0; // 0..3 dentro de pagActual
      let rutaActivaIdx = 0; // 0..7 global
      let tabDetalleActual = "acceso";
      let galeriaIdxActual = 0;

      // Precarga limpia de fotos para transición instantánea sin flashes
      const cacheFotos = new Map();
      function precargarFoto(src) {
        if (!src || cacheFotos.has(src)) return;
        const img = new Image();
        img.src = src;
        cacheFotos.set(src, img);
      }
      rutasData.forEach((r) => {
        precargarFoto(r.fotoLista);
        r.fotosDetalle.forEach((f) => precargarFoto(f));
      });

      function aplicarFotoSegura(imgEl, src, altTexto) {
        if (!imgEl || !src) return;
        if (imgEl.getAttribute("src") !== src) {
          imgEl.src = src;
        }
        imgEl.alt = altTexto;
      }

      function escaparHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function renderLista() {
        dotsPagina.forEach((btn) => {
          const esAct = btn.getAttribute("data-pag-rutas") === String(pagActual);
          btn.classList.toggle("activo", esAct);
          btn.setAttribute("aria-selected", esAct ? "true" : "false");
        });

        svgsLista.forEach((svg) => {
          svg.classList.toggle("activa", svg.getAttribute("data-svg-lista-idx") === String(posListaActual));
        });

        const base = pagActual * 4;
        botonesLista.forEach((btn, i) => {
          const r = rutasData[base + i];
          const esAct = i === posListaActual;
          btn.textContent = r.nombreLista;
          btn.classList.toggle("activo", esAct);
          btn.setAttribute("aria-selected", esAct ? "true" : "false");
        });

        rutaActivaIdx = base + posListaActual;
        const rutaSel = rutasData[rutaActivaIdx];
        aplicarFotoSegura(imgPreviewLista, rutaSel.fotoLista, `Vista previa de ${rutaSel.nombreLista}`);
      }

      function renderDetalleBullets() {
        const ruta = rutasData[rutaActivaIdx];
        const items = ruta[tabDetalleActual] || [];
        if (!listaBullets) return;
        listaBullets.innerHTML = items
          .map((item) => {
            const pref = item.prefix ? `<strong>${escaparHtml(item.prefix)}</strong> ` : "";
            return `<li><span class="bullet-punto" aria-hidden="true">•</span><span class="bullet-contenido">${pref}${escaparHtml(item.texto)}</span></li>`;
          })
          .join("");
      }

      function renderDetalleTabs() {
        svgsDetalleTab.forEach((svg) => {
          svg.classList.toggle("activa", svg.getAttribute("data-svg-tab") === tabDetalleActual);
        });
        botonesDetalleTab.forEach((btn) => {
          const esAct = btn.getAttribute("data-tab-target") === tabDetalleActual;
          btn.classList.toggle("activo", esAct);
          btn.setAttribute("aria-selected", esAct ? "true" : "false");
        });
        renderDetalleBullets();
      }

      function renderGaleriaDetalle() {
        const ruta = rutasData[rutaActivaIdx];
        dotsGaleria.forEach((btn) => {
          const esAct = btn.getAttribute("data-galeria-idx") === String(galeriaIdxActual);
          btn.classList.toggle("activo", esAct);
          btn.setAttribute("aria-selected", esAct ? "true" : "false");
        });
        const src = ruta.fotosDetalle[galeriaIdxActual] || ruta.fotosDetalle[0];
        aplicarFotoSegura(
          imgFotoDetalle,
          src,
          `Fotografía ${galeriaIdxActual + 1} de la ruta ${ruta.nombreDetalle}`
        );
      }

      function renderDetalle() {
        const ruta = rutasData[rutaActivaIdx];
        if (elTituloDetalle) elTituloDetalle.textContent = ruta.nombreDetalle;
        if (elDistNum) elDistNum.textContent = ruta.distancia;
        if (elDistNota) {
          if (ruta.distanciaNota) {
            elDistNota.textContent = ruta.distanciaNota;
            elDistNota.style.display = "inline";
          } else {
            elDistNota.textContent = "";
            elDistNota.style.display = "none";
          }
        }
        if (elTiempo) elTiempo.textContent = ruta.tiempo;
        if (elDif) elDif.textContent = ruta.dificultad;
        iconosDif.forEach((ic) => {
          ic.classList.toggle("activa", ic.getAttribute("data-icono-dif") === ruta.dificultad);
        });
        if (elDescripcion) {
          elDescripcion.innerHTML = ruta.descripcionLineas.map(escaparHtml).join("<br />");
        }
        renderDetalleTabs();
        renderGaleriaDetalle();
      }

      function cerrarModalMapa() {
        if (!modalOverlay) return;
        modalOverlay.classList.remove("abierto");
        if (modalIframe && modalIframe.getAttribute("src")) {
          modalIframe.removeAttribute("src");
        }
      }

      function abrirModalMapa() {
        if (!modalOverlay) return;
        const ruta = rutasData[rutaActivaIdx];
        if (modalTitulo) modalTitulo.textContent = `Mapa: ${ruta.nombreDetalle}`;
        if (modalSubtitulo) modalSubtitulo.textContent = ruta.mapaAccesoCorto;
        if (modalCoordsTxt) modalCoordsTxt.textContent = `Coordenadas: ${ruta.mapaCoords}`;
        const urlEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(ruta.mapaCoords)}&z=14&output=embed`;
        const urlExterno = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ruta.mapaCoords)}`;
        if (modalIframe) modalIframe.src = urlEmbed;
        if (modalLinkGmaps) modalLinkGmaps.href = urlExterno;
        modalOverlay.classList.add("abierto");
      }

      function activarVista(vistaId) {
        cerrarModalMapa();
        root.setAttribute("data-vista-actual", vistaId);
        vistas.forEach((v) => v.classList.toggle("activa", v.getAttribute("data-vista") === vistaId));

        // Letrero de madera: "Rutas del parque" está activo tanto en Vista 1 como dentro de Vista 2 (detalle)
        const enRutas = vistaId === "rutas-parque" || vistaId === "detalle-ruta";
        botonesLetrero.forEach((btn) => {
          const t = btn.getAttribute("data-vista-target");
          btn.classList.toggle("activo", enRutas && t === "rutas-parque");
        });

        // Rama decorativa derecha: visible en Intro y Rutas del Parque, oculta en Detalle
        if (ramaDerecha) {
          ramaDerecha.classList.toggle("activa", vistaId !== "detalle-ruta");
        }
      }

      botonesLetrero.forEach((btn) => {
        btn.addEventListener("click", () => {
          const destino = btn.getAttribute("data-vista-target") || "intro";
          if (destino === "rutas-parque") {
            renderLista();
          }
          activarVista(destino);
        });
      });

      dotsPagina.forEach((btn) => {
        btn.addEventListener("click", () => {
          pagActual = Number(btn.getAttribute("data-pag-rutas") || "0");
          posListaActual = 0;
          renderLista();
        });
      });

      botonesLista.forEach((btn) => {
        btn.addEventListener("click", () => {
          posListaActual = Number(btn.getAttribute("data-lista-pos") || "0");
          renderLista();
        });
      });

      if (btnVerRuta) {
        btnVerRuta.addEventListener("click", () => {
          rutaActivaIdx = pagActual * 4 + posListaActual;
          tabDetalleActual = "acceso";
          galeriaIdxActual = 0;
          renderDetalle();
          activarVista("detalle-ruta");
        });
      }

      botonesDetalleTab.forEach((btn) => {
        btn.addEventListener("click", () => {
          tabDetalleActual = btn.getAttribute("data-tab-target") || "acceso";
          renderDetalleTabs();
        });
      });

      dotsGaleria.forEach((btn) => {
        btn.addEventListener("click", () => {
          galeriaIdxActual = Number(btn.getAttribute("data-galeria-idx") || "0");
          renderGaleriaDetalle();
        });
      });

      if (btnVerMapa) {
        btnVerMapa.addEventListener("click", abrirModalMapa);
      }

      if (btnCerrarMapa) {
        btnCerrarMapa.addEventListener("click", cerrarModalMapa);
      }

      if (modalOverlay) {
        modalOverlay.addEventListener("click", (e) => {
          if (e.target === modalOverlay) cerrarModalMapa();
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modalOverlay && modalOverlay.classList.contains("abierto")) {
          cerrarModalMapa();
        }
      });

      // Soporte de parámetros URL en página independiente para enlaces directos / verificación
      const enSpa = Boolean(root.closest(".waraira-modulo-embebible"));
      if (!enSpa && window.location.search) {
        const params = new URLSearchParams(window.location.search);
        const vistaP = params.get("vista");
        const pagP = params.get("pag");
        const itemP = params.get("item");
        const rutaP = params.get("ruta");
        const tabP = params.get("tab");

        if (pagP === "0" || pagP === "1") pagActual = Number(pagP);
        if (itemP && ["0", "1", "2", "3"].includes(itemP)) posListaActual = Number(itemP);

        if (rutaP) {
          const found = rutasData.findIndex((r) => r.slug === rutaP);
          if (found >= 0) {
            rutaActivaIdx = found;
            pagActual = Math.floor(found / 4);
            posListaActual = found % 4;
          }
        }

        if (vistaP === "rutas-parque") {
          renderLista();
          activarVista("rutas-parque");
        } else if (vistaP === "detalle") {
          if (tabP === "acceso" || tabP === "caracteristicas" || tabP === "advertencias") {
            tabDetalleActual = tabP;
          }
          renderLista();
          renderDetalle();
          activarVista("detalle-ruta");
        }
      }
    });
  }

  document.addEventListener("DOMContentLoaded", inicializarModuloGuia);
  inicializarModuloGuia();
</script>

