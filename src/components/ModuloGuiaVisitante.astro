  {
    slug: "quebrada-quintero",
    nombreLista: "Quebrada Quintero",
    nombreDetalle: "Quebrada Quintero",
    distancia: "7 km",
    tiempo: "4 a 5 horas",
    dificultad: "Alta",
    descripcionLineas: [
      "Ruta que sigue el curso de la quebrada Quintero a través de densa",
      "vegetación. Ideal para excursionistas experimentados que buscan una",
      "experiencia silvestre y fresca.",
    ],
    acceso: [{ texto: "Sector Quintero / Sebucán, este de Caracas." }],
