         VISTA 3: SEGURIDAD DEL VISITANTE (PDF Págs. 74–77)
         ============================================================ -->
    <div class="vista-panel" data-vista="seguridad-visitante">
      <img
        src="/elementos/svg/contenedor-seguridad-visitante.svg"
        alt=""
        class="svg-superior-709"
        draggable="false"
      />
      <img
        src="/elementos/svg/contenedor-textos-inferior.svg"
        alt=""
        class="svg-inferior-638"
        draggable="false"
      />
      <h2 class="titulo-pestana-superior">Seguridad del visitante</h2>

      <div class="paginador-pill pag-4" data-pag-grupo="visitante" role="tablist" aria-label="Páginas de Seguridad del visitante">
        {[0, 1, 2, 3].map((i) => (
          <button
            type="button"
            class:list={["btn-dot-normativa", { activo: i === 0 }]}
            data-pag-grupo="visitante"
            data-pag-idx={String(i)}
            aria-label={`Seguridad del visitante página ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          >
            <img class="dot-img-activo" src="/elementos/svg/dot-normativa-activo.svg" alt="" draggable="false" />
            <img class="dot-img-inactivo" src="/elementos/svg/dot-normativa-inactivo.svg" alt="" draggable="false" />
          </button>
