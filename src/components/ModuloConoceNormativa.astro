<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modulos = document.querySelectorAll<HTMLElement>(".modulo-normativa");

    modulos.forEach((root) => {
      const botonesLetrero = root.querySelectorAll<HTMLButtonElement>("[data-vista-target]");
      const vistas = root.querySelectorAll<HTMLElement>(".vista-panel[data-vista]");
      const helechos = root.querySelectorAll<HTMLImageElement>(".helecho-derecha[data-helecho-vista]");

      function activarVista(id: string) {
        vistas.forEach((v) => v.classList.toggle("activa", v.dataset.vista === id));
        botonesLetrero.forEach((btn) => {
          btn.classList.toggle("activo", btn.dataset.vistaTarget === id);
        });
        helechos.forEach((img) => {
          img.classList.toggle("activa", img.dataset.helechoVista === id);
        });
      }

      botonesLetrero.forEach((btn) => {
        btn.addEventListener("click", () => {
          const destino = btn.dataset.vistaTarget || "intro";
          activarVista(destino);
        });
      });

      function activarPag(grupo: string, idx: string) {
        root.querySelectorAll<HTMLButtonElement>(`.btn-dot-normativa[data-pag-grupo="${grupo}"]`).forEach((b) => {
          const esActiva = b.dataset.pagIdx === idx;
          b.classList.toggle("activo", esActiva);
          b.setAttribute("aria-selected", esActiva ? "true" : "false");
        });

        root.querySelectorAll<HTMLElement>(`[data-pag-contenido="${grupo}"]`).forEach((panel) => {
          panel.classList.toggle("activa", panel.dataset.pagIdx === idx);
        });
      }

      const dotButtons = root.querySelectorAll<HTMLButtonElement>(".btn-dot-normativa[data-pag-grupo]");
      dotButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const grupo = btn.dataset.pagGrupo;
          const idx = btn.dataset.pagIdx;
          if (!grupo || idx === undefined) return;
          activarPag(grupo, idx);
        });
      });

      const params = new URLSearchParams(window.location.search);
      const vistaParam = params.get("vista");
      if (vistaParam) {
        activarVista(vistaParam);
        const pagParam = params.get("pag");
        const mapaGrupo: Record<string, string> = {
          "seguridad-ambiental": "ambiental",
          "acceso-horarios": "acceso",
          "seguridad-visitante": "visitante",
          "manejo-desechos": "desechos",
        };
        if (pagParam !== null && mapaGrupo[vistaParam]) {
          activarPag(mapaGrupo[vistaParam], pagParam);
        }
      }
    });
  });
</script>

