---

<section class="modulo-normativa" aria-label="Módulo Conoce su normativa">
  <EstructuraCuadrados tema="morado" fondoInicial="/fondos/bg-normativa.webp">
    <!-- Techo superior -->
    <Techo seccionActiva="normativa" />

    <!-- Letrero lateral vertical de madera -->
    <CabezalVertical tema="morado" itemActivo="intro" items={itemsMenuNormativa} />

    <!-- Helechos decorativos esquina inferior derecha según vista activa -->
    <img
      src="/elementos/helecho-normativas-intro.webp"
      alt=""
      aria-hidden="true"
      class="helecho-derecha activa"
      data-helecho-vista="intro"
      style="left: 1102px; top: 247px; width: 305px; height: 408px;"
      draggable="false"
    />
    <img
      src="/elementos/helecho-seguridad-ambiental.webp"
      alt=""
      aria-hidden="true"
      class="helecho-derecha"
      data-helecho-vista="seguridad-ambiental"
      style="left: 1094px; top: 362px; width: 310px; height: 290px;"
      draggable="false"
    />
    <img
      src="/elementos/helecho-acceso-horarios.webp"
      alt=""
      aria-hidden="true"
      class="helecho-derecha"
      data-helecho-vista="acceso-horarios"
      style="left: 1156px; top: 340px; width: 245px; height: 317px;"
      draggable="false"
    />
    <img
      src="/elementos/helecho-seguridad-visitante.webp"
      alt=""
      aria-hidden="true"
      class="helecho-derecha"
      data-helecho-vista="seguridad-visitante"
      style="left: 1111px; top: 363px; width: 289px; height: 335px;"
      draggable="false"
    />
    <img
      src="/elementos/helecho-manejo-desechos.webp"
      alt=""
      aria-hidden="true"
      class="helecho-derecha"
      data-helecho-vista="manejo-desechos"
      style="left: 1143px; top: 353px; width: 260px; height: 312px;"
      draggable="false"
    />

    <!-- ============================================================
         VISTA 0: PORTADA INTRODUCTORIA (PDF Pág. 67)
         ============================================================ -->
    <div class="vista-panel activa" data-vista="intro">
      <div class="tarjeta-svg-intro" style="left: 332px; top: 119px; width: 642.26px; height: 351.84px;">
        <img src="/elementos/svg/contenedor-normativa-intro.svg" alt="" class="fondo-svg-tarjeta" draggable="false" />
        <div class="contenido-sobre-svg">
          <h1 class="titulo-pestana-intro-morado" style="left: 38px; top: 17px;">
            Normativa del parque
          </h1>
          <div class="cuerpo-19pt texto-blanco texto-intro-normativa">
            <p>
              De acuerdo con el Plan de Ordenamiento y Reglamento de Uso<br />
              (PORU), el Instituto Nacional de Parques (INPARQUES)<br />
              establece un conjunto de normas de cumplimiento obligatorio<br />
              para garantizar la preservación de los ecosistemas del Parque<br />
              Nacional Waraira Repano y la seguridad de sus visitantes.
            </p>
            <p class="mt-14">
              Conocer y respetar estas directrices es fundamental para<br />
              disfrutar de la montaña de forma responsable.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         VISTA 1: SEGURIDAD AMBIENTAL (PDF Págs. 68–71)
         ============================================================ -->
    <div class="vista-panel" data-vista="seguridad-ambiental">
      <img
        src="/elementos/svg/contenedor-seguridad-ambiental.svg"
        alt=""
        class="svg-superior-709"
        draggable="false"
      />
      <img
        src="/elementos/svg/contenedor-textos-inferior.svg"
        alt=""
        class="svg-inferior-638"
        draggable="false"
      />
      <h2 class="titulo-pestana-superior">Seguridad ambiental</h2>

      <div class="paginador-pill pag-4" data-pag-grupo="ambiental" role="tablist" aria-label="Páginas de Seguridad ambiental">
        {[0, 1, 2, 3].map((i) => (
          <button
            type="button"
            class:list={["btn-dot-normativa", { activo: i === 0 }]}
            data-pag-grupo="ambiental"
            data-pag-idx={String(i)}
            aria-label={`Seguridad ambiental página ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          >
            <img class="dot-img-activo" src="/elementos/svg/dot-normativa-activo.svg" alt="" draggable="false" />
            <img class="dot-img-inactivo" src="/elementos/svg/dot-normativa-inactivo.svg" alt="" draggable="false" />
          </button>
        ))}
      </div>

      <p class="lead-superior" style="left: 455px; top: 213px; white-space: nowrap;">
        Nuestra principal prioridad es la conservación de este<br />espacio natural.
      </p>

      {AMBIENTAL_PAGINAS.map((pag, idx) => (
        <div
          class:list={["subpagina-grupo", { activa: idx === 0 }]}
          data-pag-contenido="ambiental"
          data-pag-idx={String(idx)}
        >
          <ul
            class="lista-bullets-normativa"
            style={`left: ${pag.x}px; top: ${pag.y}px; gap: ${pag.gap}px;`}
          >
            {pag.items.map((lineas) => (
              <li>
                <span class="bullet-simbolo" aria-hidden="true">•</span>
                <span class="bullet-texto">
                  {lineas.map((linea, lIdx) => (
                    <>
                      {linea}
                      {lIdx < lineas.length - 1 && <br />}
                    </>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- ============================================================
         VISTA 2: ACCESO Y HORARIOS (PDF Págs. 72–73)
         ============================================================ -->
    <div class="vista-panel" data-vista="acceso-horarios">
