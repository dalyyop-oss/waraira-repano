      </div>

      <p class="lead-superior" style="left: 455px; top: 213px; white-space: nowrap;">
        Disfruta la montaña sin riesgos. Revisa nuestras normas<br />de seguridad
      </p>

      {VISITANTE_PAGINAS.map((pag, idx) => (
        <div
          class:list={["subpagina-grupo", { activa: idx === 0 }]}
