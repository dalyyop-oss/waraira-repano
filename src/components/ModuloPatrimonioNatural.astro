  function inicializarPatrimonioNatural() {
    const contenedor = document.querySelector(".modulo-patrimonio-natural");
    if (!contenedor) return;
    if ((contenedor as HTMLElement).dataset.inicializado === "1") return;
    (contenedor as HTMLElement).dataset.inicializado = "1";

    const cacheFotos = new Map<string, HTMLImageElement>();
    const precargarFoto = (url: string): HTMLImageElement => {
      let cached = cacheFotos.get(url);
      if (!cached) {
        cached = new Image();
        cached.src = url;
        cacheFotos.set(url, cached);
      }
      return cached;
    };

    Object.values(CATALOGO_FLORA).forEach((lista) =>
      lista.forEach((item) => precargarFoto(item.foto))
    );
    Object.values(CATALOGO_FAUNA).forEach((lista) =>
      lista.forEach((item) => precargarFoto(item.foto))
    );

    let reqFlora = 0;
    let reqFauna = 0;

    const actualizarFotoEspecie = (
      imgEl: HTMLImageElement | null,
      foto: string,
      alt: string,
      posicion: string,
      token: number,
      getToken: () => number
    ) => {
      if (!imgEl) return;
      const cached = precargarFoto(foto);
      if (cached.complete && cached.naturalWidth > 0) {
        imgEl.style.objectPosition = posicion;
        imgEl.src = foto;
        imgEl.alt = alt;
        imgEl.style.visibility = "visible";
        return;
      }

      imgEl.style.visibility = "hidden";
      const onLoad = () => {
        cached.removeEventListener("load", onLoad);
        cached.removeEventListener("error", onError);
        if (token !== getToken()) return;
        imgEl.style.objectPosition = posicion;
        imgEl.src = foto;
        imgEl.alt = alt;
        imgEl.style.visibility = "visible";
      };
      const onError = () => {
        cached.removeEventListener("load", onLoad);
        cached.removeEventListener("error", onError);
        if (token !== getToken()) return;
        imgEl.style.objectPosition = posicion;
        imgEl.src = foto;
        imgEl.alt = alt;
        imgEl.style.visibility = "visible";
      };
      cached.addEventListener("load", onLoad);
      cached.addEventListener("error", onError);
    };

    const imgFondo = contenedor.querySelector("#img-fondo-activo") as HTMLImageElement | null;
    const cambiarFondo = (src: string) => {
      if (imgFondo && imgFondo.getAttribute("src") !== src) {
        imgFondo.src = src;
      }
    };

    // 1. Navegación desde el letrero de madera lateral
    const botonesVista = contenedor.querySelectorAll("[data-vista-target]");
    const pantallas = contenedor.querySelectorAll(".pantalla-vista");

    botonesVista.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-vista-target");
        if (!target) return;

        botonesVista.forEach((b) => b.classList.remove("activo"));
        btn.classList.add("activo");

        pantallas.forEach((p) => {
          const esTarget = p.getAttribute("data-vista") === target;
          p.classList.toggle("activa", esTarget);
          if (esTarget) {
            const bg = p.getAttribute("data-bg");
            if (bg) cambiarFondo(bg);
          }
        });
      });
    });

    // 2. Geología: Paginación de 2 cuadros (Página 8 vs Páginas 9-13)
    const geoDots = contenedor.querySelectorAll("[data-geo-page]");
    const geoPages = contenedor.querySelectorAll("[data-geo-content]");

    const activarPaginaGeologia = (numPag: string) => {
      geoDots.forEach((d) =>
        d.classList.toggle("activo", d.getAttribute("data-geo-page") === numPag)
      );
      geoPages.forEach((p) =>
        p.classList.toggle("activa", p.getAttribute("data-geo-content") === numPag)
      );
      cambiarFondo(
        numPag === "1" ? "/fondos/bg-geologia.webp" : "/fondos/bg-geologia.webp"
      );
    };

    geoDots.forEach((d) => {
      d.addEventListener("click", () => {
        const p = d.getAttribute("data-geo-page");
        if (p) activarPaginaGeologia(p);
      });
    });

    // Selector de los 5 Picos en Geología (Páginas 9 a 13)
    const btnsCumbres = contenedor.querySelectorAll("[data-cumbre-foto]");
    const imgCumbre = contenedor.querySelector("#img-cumbre-activa") as HTMLImageElement | null;
    const descCumbre = contenedor.querySelector("#desc-cumbre-activa");
    const alturaCumbre = contenedor.querySelector("#altura-cumbre-activa");

    btnsCumbres.forEach((btn) => {
      btn.addEventListener("click", () => {
        btnsCumbres.forEach((b) => b.classList.remove("activo"));
        btn.classList.add("activo");
        const foto = btn.getAttribute("data-cumbre-foto");
        const desc = btn.getAttribute("data-cumbre-desc");
        const altura = btn.getAttribute("data-cumbre-altura");
        if (imgCumbre && foto) imgCumbre.src = foto;
        if (descCumbre && desc !== null) descCumbre.textContent = desc;
        if (alturaCumbre && altura !== null) alturaCumbre.textContent = altura;
        const svgCumbreFondo = contenedor.querySelector('#img-svg-cumbre-fondo') as HTMLImageElement | null;
        const svg = btn.getAttribute('data-cumbre-svg');
        if (svgCumbreFondo && svg) svgCumbreFondo.src = svg;
      });
    });

    // 3. Flora y Fauna: Pestañas principales (Flora vs Fauna)
    let tabFFActual = "flora";
    let pagFloraActual = "1";
    let pagFaunaActual = "1";
    let catFloraActual = "emblematicas";
    let idxFloraActual = 0;
    let catFaunaActual = "mamiferos";
    let idxFaunaActual = 0;

    const pestanasFF = contenedor.querySelectorAll(".pestana-ff-item");
    const bloquesFF = contenedor.querySelectorAll(".bloque-ff");

    const actualizarFondoFloraFauna = () => {
      if (tabFFActual === "flora") {
        cambiarFondo(
          pagFloraActual === "1"
            ? "/fondos/bg-flora-fauna.webp"
            : "/fondos/bg-flora-fauna.webp"
        );
      } else {
        cambiarFondo("/fondos/bg-flora-fauna.webp");
      }
    };

    const cambiarTabFF = (nuevoTab: string) => {
      tabFFActual = nuevoTab;
      pestanasFF.forEach((t) =>
        t.classList.toggle("activa", t.getAttribute("data-ff-tab") === nuevoTab)
      );
      bloquesFF.forEach((b) =>
        b.classList.toggle("activo", b.getAttribute("data-ff-content") === nuevoTab)
      );
      actualizarFondoFloraFauna();
    };

    contenedor.querySelectorAll("[data-ff-select]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const t = btn.getAttribute("data-ff-select");
        if (t) cambiarTabFF(t);
      });
    });

    // Cuadros de Flora (1 vs 2)
    const floraDots = contenedor.querySelectorAll("[data-flora-page]");
    const floraSubpages = contenedor.querySelectorAll("[data-flora-content]");

    const activarPaginaFlora = (num: string) => {
      if (tabFFActual !== "flora") cambiarTabFF("flora");
      pagFloraActual = num;
      floraDots.forEach((d) =>
        d.classList.toggle("activo", d.getAttribute("data-flora-page") === num)
      );
      floraSubpages.forEach((sp) =>
        sp.classList.toggle("activa", sp.getAttribute("data-flora-content") === num)
      );
      actualizarFondoFloraFauna();
    };

    floraDots.forEach((d) => {
      d.addEventListener("click", (e) => {
        e.stopPropagation();
        const num = d.getAttribute("data-flora-page");
        if (num) activarPaginaFlora(num);
      });
    });

    // Renderizar especie de Flora activa
    const imgFlora = contenedor.querySelector("#img-flora-especie") as HTMLImageElement | null;
    const nomFloraComun = contenedor.querySelector("#nombre-flora-comun");
    const nomFloraCient = contenedor.querySelector("#nombre-flora-cientifico");
    const recorteFlora = contenedor.querySelector("#recorte-flora-derecho") as HTMLImageElement | null;
    const btnsFloraCat = contenedor.querySelectorAll("[data-flora-cat]");
    const btnsFloraIdx = contenedor.querySelectorAll("[data-flora-idx]");

    const renderFlora = () => {
      const lista = CATALOGO_FLORA[catFloraActual];
      if (!lista) return;
      const item = lista[idxFloraActual] || lista[0];
      actualizarFotoEspecie(
        imgFlora,
        item.foto,
        item.comun,
        item.posicionFoto || "center",
        ++reqFlora,
        () => reqFlora
      );
      if (nomFloraComun) nomFloraComun.textContent = item.comun;
      if (nomFloraCient) nomFloraCient.textContent = item.cientifico;
      if (recorteFlora) recorteFlora.src = item.recorte;

      const mapaSvgFlora: Record<string, string> = {
        emblematicas: "/elementos/svg/contenedor-fauna-flora-1.svg",
        orquideas: "/elementos/svg/contenedor-fauna-flora-2.svg",
        helechos: "/elementos/svg/contenedor-fauna-flora-3.svg",
        endemicas: "/elementos/svg/contenedor-fauna-flora-4.svg",
      };
      const svgFloraCat = contenedor.querySelector("#svg-fondo-flora-catalogo") as HTMLImageElement | null;
      if (svgFloraCat && mapaSvgFlora[catFloraActual]) {
        svgFloraCat.src = mapaSvgFlora[catFloraActual];
      }

      btnsFloraCat.forEach((b) =>
        b.classList.toggle("activo", b.getAttribute("data-flora-cat") === catFloraActual)
      );
      btnsFloraIdx.forEach((b) =>
        b.classList.toggle("activo", Number(b.getAttribute("data-flora-idx")) === idxFloraActual)
      );
    };

    btnsFloraCat.forEach((btn) => {
      btn.addEventListener("click", () => {
        const c = btn.getAttribute("data-flora-cat");
        if (c) {
          catFloraActual = c;
          idxFloraActual = 0;
          renderFlora();
        }
      });
    });

    btnsFloraIdx.forEach((btn) => {
      btn.addEventListener("click", () => {
        idxFloraActual = Number(btn.getAttribute("data-flora-idx") || 0);
        renderFlora();
      });
    });

    // Cuadros de Fauna (1 vs 2)
    const faunaDots = contenedor.querySelectorAll("[data-fauna-page]");
    const faunaSubpages = contenedor.querySelectorAll("[data-fauna-content]");

    const activarPaginaFauna = (num: string) => {
      if (tabFFActual !== "fauna") cambiarTabFF("fauna");
      pagFaunaActual = num;
      faunaDots.forEach((d) =>
        d.classList.toggle("activo", d.getAttribute("data-fauna-page") === num)
      );
      faunaSubpages.forEach((sp) =>
        sp.classList.toggle("activa", sp.getAttribute("data-fauna-content") === num)
      );
      actualizarFondoFloraFauna();
    };

    faunaDots.forEach((d) => {
      d.addEventListener("click", (e) => {
        e.stopPropagation();
        const num = d.getAttribute("data-fauna-page");
        if (num) activarPaginaFauna(num);
      });
    });

    // Renderizar especie de Fauna activa
    const imgFauna = contenedor.querySelector("#img-fauna-especie") as HTMLImageElement | null;
    const nomFaunaComun = contenedor.querySelector("#nombre-fauna-comun");
    const nomFaunaCient = contenedor.querySelector("#nombre-fauna-cientifico");
    const recorteFauna = contenedor.querySelector("#recorte-fauna-derecho") as HTMLImageElement | null;
    const btnsFaunaCat = contenedor.querySelectorAll("[data-fauna-cat]");
    const btnsFaunaIdx = contenedor.querySelectorAll("[data-fauna-idx]");

    const renderFauna = () => {
      const lista = CATALOGO_FAUNA[catFaunaActual];
      if (!lista) return;
      const item = lista[idxFaunaActual] || lista[0];
      actualizarFotoEspecie(
        imgFauna,
        item.foto,
        item.comun,
        item.posicionFoto || "center",
        ++reqFauna,
        () => reqFauna
      );
      if (nomFaunaComun) nomFaunaComun.textContent = item.comun;
      if (nomFaunaCient) nomFaunaCient.textContent = item.cientifico;
      if (recorteFauna) recorteFauna.src = item.recorte;

      const mapaSvgFauna: Record<string, string> = {
        mamiferos: "/elementos/svg/contenedor-fauna-flora-1.svg",
        aves: "/elementos/svg/contenedor-fauna-flora-2.svg",
        reptiles: "/elementos/svg/contenedor-fauna-flora-3.svg",
        anfibios: "/elementos/svg/contenedor-fauna-flora-4.svg",
      };
      const svgFaunaCat = contenedor.querySelector("#svg-fondo-fauna-catalogo") as HTMLImageElement | null;
      if (svgFaunaCat && mapaSvgFauna[catFaunaActual]) {
        svgFaunaCat.src = mapaSvgFauna[catFaunaActual];
      }

      btnsFaunaCat.forEach((b) =>
        b.classList.toggle("activo", b.getAttribute("data-fauna-cat") === catFaunaActual)
      );
      btnsFaunaIdx.forEach((b) =>
        b.classList.toggle("activo", Number(b.getAttribute("data-fauna-idx")) === idxFaunaActual)
      );
    };

    btnsFaunaCat.forEach((btn) => {
      btn.addEventListener("click", () => {
        const c = btn.getAttribute("data-fauna-cat");
        if (c) {
          catFaunaActual = c;
          idxFaunaActual = 0;
          renderFauna();
        }
      });
    });

    btnsFaunaIdx.forEach((btn) => {
      btn.addEventListener("click", () => {
        idxFaunaActual = Number(btn.getAttribute("data-fauna-idx") || 0);
        renderFauna();
      });
    });

    // Soporte para abrir directamente una subsección mediante URL (?vista=geologia o #geologia)
    const urlParams = new URLSearchParams(window.location.search);
    const vistaParam = urlParams.get('vista') || window.location.hash.replace('#', '');
    if (vistaParam) {
      const btnVista = contenedor.querySelector(`[data-vista-target="${vistaParam}"]`);
      if (btnVista) (btnVista as HTMLElement).click();

      const pagParam = urlParams.get('pag');
      if (pagParam) {
        if (vistaParam === 'geologia') {
          activarPaginaGeologia(pagParam);
        } else if (vistaParam === 'flora-fauna') {
          const subParam = urlParams.get('sub');
          if (subParam === 'fauna') {
            cambiarTabFF('fauna');
            activarPaginaFauna(pagParam);
          } else {
            cambiarTabFF('flora');
            activarPaginaFlora(pagParam);
          }
        }
      }
    }
  }

  document.addEventListener("DOMContentLoaded", inicializarPatrimonioNatural);
  inicializarPatrimonioNatural();
</script>

