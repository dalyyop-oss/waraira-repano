---
import Techo from "./Techo.astro";
import CabezalVertical from "./CabezalVertical.astro";
import EstructuraCuadrados from "./EstructuraCuadrados.astro";

const B = "/elementos/botones/";
const itemsLetrero = [
  { id: "clima", etiqueta: "Clima", inactivo: B + "clima-inactivo.webp", activo: B + "clima-activo.webp" },
  { id: "geologia", etiqueta: "Geología", inactivo: B + "geologia-inactivo.webp", activo: B + "geologia-activo.webp" },
  { id: "hidrografia", etiqueta: "Hidrografía", inactivo: B + "hidrografia-inactivo.webp", activo: B + "hidrografia-activo.webp" },
  { id: "flora-fauna", etiqueta: "Flora y Fauna", inactivo: B + "flora-fauna-inactivo.webp", activo: B + "flora-fauna-activo.webp" },
];

export interface Props {
  vistaInicial?: "intro" | "clima" | "geologia" | "hidrografia" | "flora-fauna";
}

const { vistaInicial = "intro" } = Astro.props;

const cumbresGeologia = [
  {
    id: "pico-el-avila",
    nombre: "Pico El Ávila",
    foto: "/fotos/geologia/pico-el-avila.webp",
    svgContenedor: "/elementos/svg/contenedor-pico-el-avila.svg",
    desc: "Es la cima de mayor infraestructura turística.",
    altura: "Altura: (2.459 m.s.n)",
  },
  {
    id: "pico-oriental",
    nombre: "Pico Oriental",
    foto: "/fotos/geologia/pico-oriental.webp",
    svgContenedor: "/elementos/svg/contenedor-pico-oriental.svg",
    desc: "Es la segunda cumbre más alta del parque.",
    altura: "Altura: (2.459 m.s.n)",
  },
  {
    id: "pico-occidental",
    nombre: "Pico Occidental",
    foto: "/fotos/geologia/pico-occidental.webp",
    svgContenedor: "/elementos/svg/contenedor-pico-occidental.svg",
    desc: "Es una de las cumbres principales del Parque nacional Waraira Repano.",
    altura: "Altura: (2.478 m.s.n)",
  },
  {
    id: "pico-naiguata",
    nombre: "Pico Naiguatá",
    foto: "/fotos/geologia/pico-naiguata.webp",
    svgContenedor: "/elementos/svg/contenedor-pico-naiguata.svg",
    desc: "Es la cumbre más alta de la Cordillera de la Costa y del parque.",
    altura: "Altura: (2.765 m.s.n)",
  },
  {
    id: "silla-de-caracas",
    nombre: "Silla de Caracas",
    foto: "/fotos/geologia/silla-de-caracas.webp",
    svgContenedor: "/elementos/svg/contenedor-silla-de-caracas.svg",
    desc: "Está compuesta por el Pico Occidental y el Pico Oriental",
    altura: "",
  },
];
---

<section class="modulo-patrimonio-natural" aria-label="Sección Patrimonio natural">
  <EstructuraCuadrados tema="amarillo" fondoInicial={vistaInicial === "geologia" ? "/fondos/bg-geologia.webp" : (vistaInicial === "flora-fauna" ? "/fondos/bg-flora-fauna.webp" : "/fondos/bg-patrimonio-intro.webp")}>
    <!-- Cabezal superior de 5 secciones -->
    <Techo seccionActiva="patrimonio-natural" />

    <!-- Letrero de madera lateral izquierdo -->
    <CabezalVertical tema="amarillo" items={itemsLetrero} itemActivo={vistaInicial} />

    <!-- =====================================================================
         PANTALLA 6 (Página 6 del PDF): Intro - Patrimonio Natural (SVG 642×351.23)
         ===================================================================== -->
    <article
      class:list={["pantalla-vista", { activa: vistaInicial === "intro" }]}
      data-vista="intro"
      data-bg="/fondos/bg-patrimonio-intro.webp"
    >
      <!-- Contenedor gráfico SVG preciso de Intro Patrimonio Natural -->
      <div
        class="contenedor-svg-card"
        style="left: 330px; top: 122px; width: 642px; height: 351px;"
      >
        <img src="/elementos/svg/contenedor-patrimonio-intro.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
        <span class="titulo-pestana texto-amarillo" style="position: absolute; left: 50px; top: 15px;">Patrimonio Natural</span>
        <div class="contenido-sobre-svg" style="top: 80px; padding: 24px 48px;">
          <p class="cuerpo-19pt texto-blanco">
            Decretado como Parque Nacional el 12 de diciembre de 1958<br />
            (Decreto N° 473). El parque abarca una superficie de más de<br />
            85.000 hectáreas que se extienden a lo largo de la serranía.
          </p>
          <p class="cuerpo-19pt texto-blanco" style="margin-top: 14px;">
            En 2010, mediante la Ley de Protección del Parque Nacional, se<br />
            ratificó de forma oficial la denominación indígena Waraira<br />
            Repano, término derivado de la lengua de las etnias originarias<br />
            Caribes que significa «Sierra Grande» o «Lugar de dantas».
          </p>
        </div>
      </div>

      <!-- Rama derecha Página 6 -->
      <img
        src="/elementos/rama-patrimonio-derecha.webp"
        alt=""
        aria-hidden="true"
        class="recorte-derecho"
        style="left: 1083px; top: 280px; width: 317px; height: 370px; object-position: right bottom;"
        draggable="false"
      />
    </article>

    <!-- =====================================================================
         PANTALLA 7 (Página 7 del PDF): Clima (SVG 642×349.81)
         ===================================================================== -->
    <article
      class:list={["pantalla-vista", { activa: vistaInicial === "clima" }]}
      data-vista="clima"
      data-bg="/fondos/bg-clima.webp"
    >
      <!-- Contenedor gráfico SVG preciso de Clima -->
      <div
        class="contenedor-svg-card"
        style="left: 330px; top: 122px; width: 642px; height: 350px;"
      >
        <img src="/elementos/svg/contenedor-clima.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
        <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 15px;">Clima</span>
        <div class="contenido-sobre-svg" style="top: 55px; padding: 48px 50px;">
          <p class="cuerpo-19pt texto-verde">
            El clima del Parque es de montaña, con diferencias notables de<br />
            acuerdo con la altitud y los pisos térmicos correspondientes<br />
            y también de acuerdo a la exposición de sus laderas con<br />
            respecto a la insolación y a la procedencia de los vientos.
          </p>

          <div class="insignia-clima">
            <img
              src="/iconos/icono-clima-frio.webp"
              alt="Icono Clima frío de montaña"
              class="icono-clima-img"
            />
            <span class="subtitulo-20pt-amarillo">Clima frío de montaña</span>
          </div>
        </div>
      </div>

      <!-- Tarjeta fotográfica derecha (SVG 261×296): Pico Naiguatá en Clima: x=984..1245, y=176..473 -->
      <div
        class="tarjeta-derecha-foto"
        style="left: 984px; top: 176px; width: 261px; height: 296px;"
      >
        <img src="/elementos/svg/contenedor-pico-naiguata-clima.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
        <div class="marco-foto-derecha" style="position: relative; z-index: 2;">
          <img
            src="/fotos/patrimonio/pico-naiguata-clima.webp"
            alt="Pico Naiguatá"
          />
        </div>
        <p class="pie-foto-13pt" style="position: relative; z-index: 2; margin-top: 14px;">Pico Naiguatá</p>
      </div>

      <!-- Nubes primer plano derecho Página 7 -->
      <img
        src="/elementos/nube-clima-1.webp"
        alt=""
        aria-hidden="true"
        class="recorte-derecho"
        style="left: 1141px; top: 120px; width: 259px; height: 280px;"
        draggable="false"
      />
      <img
        src="/elementos/nube-clima-2.webp"
        alt=""
        aria-hidden="true"
        class="recorte-derecho"
        style="left: 740px; top: 380px; width: 650px; height: 260px;"
        draggable="false"
      />
    </article>

    <!-- =====================================================================
         PANTALLAS 8 a 13 (Páginas 8 a 13 del PDF): Geología (SVGs de Geología)
         ===================================================================== -->
    <article
      class:list={["pantalla-vista", { activa: vistaInicial === "geologia" }]}
      data-vista="geologia"
      data-bg="/fondos/bg-geologia.webp"
      id="vista-geologia"
    >
      <!-- GEOLOGÍA PUNTO 1 (Página 8 del PDF): Contenedor gráfico SVG Geología (649.12×350.16) -->
      <div class="subpagina-geologia activa" data-geo-content="1">
        <div
          class="contenedor-svg-card"
          style="left: 330px; top: 122px; width: 649px; height: 350px;"
        >
          <img src="/elementos/svg/contenedor-geologia.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
          <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 15px;">Geología</span>
          <div class="muesca-paginador muesca-geologia" role="tablist" aria-label="Páginas de Geología">
            <button
              type="button"
              class="cuadro-paginador activo"
              data-geo-page="1"
              title="Página 1: Origen geológico"
              aria-label="Origen geológico"
            ></button>
            <button
              type="button"
              class="cuadro-paginador"
              data-geo-page="2"
              title="Página 2: Principales cumbres y picos"
              aria-label="Principales cumbres"
            ></button>
          </div>
          <div class="contenido-sobre-svg" style="top: 55px; padding: 44px 54px;">
            <p class="cuerpo-19pt texto-verde">
              Corresponde a una abrupta región montañosa con laderas muy<br />
              pendientes, originada a partir del hundimiento de la placa del<br />
              Caribe y el levantamiento de la placa continental sudamericana<br />
              durante el período Eoceno.
            </p>
            <p class="cuerpo-19pt texto-verde" style="margin-top: 12px;">
              También está constituido por rocas deformadas y meteorizadas<br />
              del período Cretácico.
            </p>
          </div>
        </div>

        <img
          src="/elementos/rocas-geologia-1.webp"
          alt=""
          aria-hidden="true"
          class="recorte-derecho"
          style="left: 1080px; top: 320px; width: 320px; height: 330px; object-position: right bottom;"
          draggable="false"
        />
      </div>

      <!-- GEOLOGÍA PUNTO 2 (Páginas 9 a 13 del PDF): Selector interactivo de 5 Picos -->
      <div class="subpagina-geologia" data-geo-content="2">
        <!-- Tarjeta superior SVG corta con arco recortado (709.3×236.97) -->
        <div
          class="contenedor-svg-card"
          style="left: 330px; top: 122px; width: 709px; height: 237px;"
        >
          <img src="/elementos/svg/contenedor-geologia-corto.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
          <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 15px;">Geología</span>
          <div class="muesca-paginador muesca-geologia" role="tablist" aria-label="Páginas de Geología">
            <button
              type="button"
              class="cuadro-paginador"
              data-geo-page="1"
              title="Página 1: Origen geológico"
              aria-label="Origen geológico"
            ></button>
            <button
              type="button"
              class="cuadro-paginador activo"
              data-geo-page="2"
              title="Página 2: Principales cumbres y picos"
              aria-label="Principales cumbres"
            ></button>
          </div>
          <div class="contenido-sobre-svg" style="top: 55px; padding: 40px 52px;">
            <p class="cuerpo-19pt texto-verde">
              Al recorrer la cordillera, destacan de forma natural sus puntos<br />
              más elevados:
            </p>
          </div>
        </div>

        <!-- Contenedor L-shaped SVG interactivo de la cumbre activa -->
        <div class="area-interactiva-cumbres" style="position: absolute; left: 366px; top: 312px; width: 642px; height: 260px; z-index: 25;">
          <img id="img-svg-cumbre-fondo" src="/elementos/svg/contenedor-pico-el-avila.svg" alt="" aria-hidden="true" class="svg-fondo-cumbre" draggable="false" />

          <!-- 5 botones de picos a la izquierda -->
          <div class="columna-botones-picos" style="position: absolute; left: 0; top: 0;">
            {
              cumbresGeologia.map((cumbre, idx) => (
                <button
                  type="button"
                  class:list={["btn-pico-geologia", { activo: idx === 0 }]}
                  data-cumbre-foto={cumbre.foto}
                  data-cumbre-desc={cumbre.desc}
                  data-cumbre-altura={cumbre.altura}
                  data-cumbre-svg={cumbre.svgContenedor}
                >
                  {cumbre.nombre}
                </button>
              ))
            }
          </div>

          <!-- Tarjeta fotográfica derecha de cumbres -->
          <div
            class="tarjeta-foto-cumbre"
            style="position: absolute; left: 310px; top: 0; width: 332px; height: 260px;"
          >
            <div class="marco-foto-cumbre">
              <img
                id="img-cumbre-activa"
                src="/fotos/geologia/pico-el-avila.webp"
                alt="Pico El Ávila"
              />
            </div>
            <div class="texto-pie-cumbre">
              <p id="desc-cumbre-activa" class="pie-13pt-cumbre">
                Es la cima de mayor infraestructura turística.
              </p>
              <p id="altura-cumbre-activa" class="pie-13pt-cumbre" style="margin-top: 10px;">
                Altura: (2.459 m.s.n)
              </p>
            </div>
          </div>
        </div>

        <img
          src="/elementos/rocas-geologia-2.webp"
          alt=""
          aria-hidden="true"
          class="recorte-derecho"
          style="left: 1120px; top: 370px; width: 280px; height: 280px; object-position: right bottom;"
          draggable="false"
        />
      </div>
    </article>

    <!-- =====================================================================
         PANTALLA 14 (Página 14 del PDF): Hidrografía (SVGs precisos 639×237 y 576×168)
         ===================================================================== -->
    <article
      class:list={["pantalla-vista", { activa: vistaInicial === "hidrografia" }]}
      data-vista="hidrografia"
      data-bg="/fondos/bg-hidrografia.webp"
    >
      <!-- Contenedor superior gráfico SVG Hidrografía -->
      <div
        class="contenedor-svg-card"
        style="left: 330px; top: 122px; width: 639px; height: 237px;"
      >
        <img src="/elementos/svg/contenedor-hidrografia.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
        <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 15px;">Hidrografía</span>
        <div class="contenido-sobre-svg" style="top: 55px; padding: 42px 46px;">
          <p class="cuerpo-19pt texto-verde">
            El abundante volumen de agua del parque drena al <strong>mar Caribe</strong><br />
            mediante una densa red hidrográfica <strong class="texto-amarillo-intenso">dividida en dos vertientes:</strong>
          </p>
        </div>
      </div>

      <!-- 2 Tarjetas de Vertientes alojadas bajo el arco en SVG dual preciso -->
      <div class="fila-vertientes-svg" style="position: absolute; left: 364px; top: 315px; width: 576px; height: 168px; z-index: 26;">
        <img src="/elementos/svg/contenedores-duales-hidrografia.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
        <div style="display: flex; gap: 18px; width: 100%; height: 100%; position: relative; z-index: 2;">
          <!-- Vertiente Norte -->
          <div class="caja-vertiente-contenido" style="width: 279px; padding: 18px 22px;">
            <h2 class="titulo-vertiente-20pt">Vertiente Norte</h2>
            <ul class="lista-15pt">
              <li>
                Desemboca directamente en<br />el Litoral Central.
              </li>
              <li style="margin-top: 8px;">
                Alimenta la cuenca del río<br />Guaire, principal colector de<br />la capital.
              </li>
            </ul>
          </div>

          <!-- Vertiente Sur -->
          <div class="caja-vertiente-contenido" style="width: 279px; padding: 18px 22px;">
            <h2 class="titulo-vertiente-20pt">Vertiente Sur</h2>
            <ul class="lista-15pt">
              <li>
                Desemboca de forma indirecta,<br />principalmente a través del<br />río Tuy.
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Cascada y rocas primer plano derecho Página 14 -->
      <img
        src="/elementos/cascada-hidrografia-derecha.webp"
        alt=""
        aria-hidden="true"
        class="recorte-derecho"
        style="left: 1080px; top: 365px; width: 320px; height: 285px; object-position: right bottom;"
        draggable="false"
      />
    </article>

    <!-- =====================================================================
         PANTALLAS 15 a 40 (Páginas 15 a 40 del PDF): Flora y Fauna (SVGs vectoriales precisos)
         ===================================================================== -->
    <article
      class:list={["pantalla-vista", { activa: vistaInicial === "flora-fauna" }]}
      data-vista="flora-fauna"
      data-bg="/fondos/bg-flora-fauna.webp"
      id="vista-flora-fauna"
    >
      <!-- ===============================================================
           CONTENIDO FLORA (Páginas 15 a 27)
           =============================================================== -->
      <div class="bloque-ff activo" data-ff-content="flora">
        <!-- FLORA PUNTO 1 (Página 15): Introducción con SVG Flora (639.18×266.14) -->
        <div class="subpagina-flora activa" data-flora-content="1">
          <div
            class="contenedor-svg-card"
            style="left: 330px; top: 122px; width: 639px; height: 266px;"
          >
            <img src="/elementos/svg/contenedor-flora.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
            <!-- Botones interactivos transparentes para alternar pestañas Flora / Fauna -->
            <button type="button" class="btn-pestana-svg activa" data-ff-select="flora" style="left: 0; top: 0; width: 213px; height: 55px;">
              <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 17px;">Flora</span>
            </button>
            <button type="button" class="btn-pestana-svg" data-ff-select="fauna" style="left: 213px; top: 0; width: 213px; height: 55px;">
              <span class="titulo-pestana texto-blanco" style="position: absolute; left: 70px; top: 17px;">Fauna</span>
            </button>
            <!-- Manejadores activo / inactivo en la muesca de Flora (x=158px, y=34px) -->
            <div class="muesca-paginador muesca-flora" role="tablist" aria-label="Páginas de Flora">
              <button
                type="button"
                class="cuadro-paginador activo"
                data-flora-page="1"
                title="Introducción a la Flora (Página 15)"
                aria-label="Página 1: Introducción a la Flora"
              ></button>
              <button
                type="button"
                class="cuadro-paginador"
                data-flora-page="2"
                title="Catálogo de especies de Flora (Páginas 16 a 27)"
                aria-label="Página 2: Catálogo de especies de Flora"
              ></button>
            </div>
            <div class="contenido-sobre-svg" style="top: 55px; padding: 40px 50px;">
              <p class="cuerpo-19pt texto-verde">
                El parque alberga una extraordinaria diversidad vegetal que<br />
                varía con la altitud. Desde los bosques secos de la base<br />
                hasta los subpáramos de las cumbres, cada piso altitudinal<br />
                presenta comunidades vegetales únicas y adaptadas a sus<br />
                condiciones específicas.
              </p>
            </div>
          </div>

          <img
            src="/elementos/orquidea-flora-intro.webp"
            alt=""
            aria-hidden="true"
            class="recorte-derecho"
            style="left: 1050px; top: 270px; width: 350px; height: 380px; object-position: right bottom;"
            draggable="false"
          />
        </div>

        <!-- FLORA PUNTO 2 (Páginas 16 a 27): 4 Categorías x 3 Especies (SVG 709.9×238.06) -->
        <div class="subpagina-flora" data-flora-content="2">
          <!-- Tarjeta superior SVG corta con arco recortado -->
          <div
            class="contenedor-svg-card"
            style="left: 330px; top: 122px; width: 710px; height: 238px;"
          >
            <img src="/elementos/svg/contenedor-flora-corto.svg" alt="" aria-hidden="true" class="svg-fondo-card" draggable="false" />
            <!-- Botones de pestañas Flora / Fauna -->
            <button type="button" class="btn-pestana-svg activa" data-ff-select="flora" style="left: 0; top: 0; width: 213px; height: 55px;">
              <span class="titulo-pestana texto-blanco" style="position: absolute; left: 50px; top: 17px;">Flora</span>
            </button>
            <button type="button" class="btn-pestana-svg" data-ff-select="fauna" style="left: 213px; top: 0; width: 213px; height: 55px;">
              <span class="titulo-pestana texto-blanco" style="position: absolute; left: 70px; top: 17px;">Fauna</span>
            </button>
            <!-- Manejadores activo / inactivo en la muesca de Flora (Punto 2 activo) -->
            <div class="muesca-paginador muesca-flora" role="tablist" aria-label="Páginas de Flora">
              <button
                type="button"
                class="cuadro-paginador"
                data-flora-page="1"
                title="Introducción a la Flora (Página 15)"
                aria-label="Página 1: Introducción a la Flora"
              ></button>
              <button
                type="button"
                class="cuadro-paginador activo"
                data-flora-page="2"
                title="Catálogo de especies de Flora (Páginas 16 a 27)"
                aria-label="Página 2: Catálogo de especies de Flora"
              ></button>
            </div>
            <div class="contenido-sobre-svg" style="top: 55px; padding: 42px 52px;">
              <p class="cuerpo-19pt texto-verde">
                Dentro de esta vasta riqueza botánica destacan:
              </p>
            </div>
          </div>

          <!-- Contenedor unificado de catálogo Flora (SVG 640×220 en x=366, y=312) -->
          <div class="contenedor-catalogo-ff" style="left: 366px; top: 312px; width: 640px; height: 220px;">
            <img
              id="svg-fondo-flora-catalogo"
              src="/elementos/svg/contenedor-fauna-flora-1.svg"
              alt=""
              aria-hidden="true"
              class="svg-fondo-catalogo"
              draggable="false"
            />

            <!-- 4 Botones de categorías de Flora con rectángulo SVG badge-nombre-flora-fauna inactivo -->
            <div class="columna-botones-ff">
              <button
                type="button"
                class="btn-categoria-ff activo"
                data-flora-cat="emblematicas"
              >
                <img src="/elementos/svg/badge-nombre-flora-fauna.svg" alt="" aria-hidden="true" class="badge-inactivo" draggable="false" />
                <span class="btn-ff-texto">Plantas emblemáticas</span>
              </button>
              <button
                type="button"
                class="btn-categoria-ff"
                data-flora-cat="orquideas"
              >
